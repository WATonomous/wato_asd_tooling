#!/usr/bin/env bash
# asd-dev (laptop side): start, stop and check your WATcloud dev sessions from this computer.
# Each command runs ~/.asd-dev/bin/asd-dev on the login node; "start" then opens VS Code.
# On native Windows use asd-dev.cmd. Run ./setup.sh first.
set -o errexit -o nounset -o pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SSH_ARGS=()
if [[ -n ${ASD_DEV_SSH_CONFIG:-} ]]; then SSH_ARGS+=(-F "$ASD_DEV_SSH_CONFIG"); fi

usage() {
    cat <<'EOF'
Usage: ./asd-dev COMMAND [args]

  start [--name NAME] [options]  start a session, wait until it is ready, open VS Code
                          options are sbatch's: --cpus-per-task/-c N --mem 16G --time/-t 6:00:00
                          --gres tmpdisk:MiB,shard:MiB --gpus/-G N --partition/-p NAME
                          --nodelist/-w NODES --exclude/-x NODES; also --docker-state yes|no,
                          --no-code (do not open VS Code), --folder PATH
  code [--name NAME] [--folder PATH]  open VS Code in a running session
  add --name NAME         add the host asd-dev-session-NAME for a named session (start does it too)
  stop [--name NAME] [--now]  stop a session (--all: every session)
  status [--name NAME]    list your sessions
  logs [--name NAME] [-f] show a session's log
  config [options]        show or change your session defaults (the options of start;
                          --unset OPTION removes one), e.g. config --gres tmpdisk:40960
  ssh [--name NAME] [command]  open a terminal (or run a command) in a session
  setup [options]         run ./setup.sh

Without --name a command means the default session; --name gpu means asd-dev-session-gpu.
Connecting VS Code only connects: start a session first with "start"; it ends at its time
limit or with "stop".
EOF
}

# The helper path from the session host's ProxyCommand (setup's --cluster-dir can change it).
helper_path() {
    ssh -n ${SSH_ARGS[@]+"${SSH_ARGS[@]}"} -T -G asd-dev-session 2>/dev/null |
        awk '$1 == "proxycommand" { for (i = 2; i <= NF; i++) if ($i ~ /\/bin\/asd-dev$/) { print $i; exit } }'
}

remote() { # runs the cluster helper with the given arguments
    local cmd a rc=0
    cmd=$(helper_path)
    # --from tells the helper to print command hints in this wrapper's form (./asd-dev ...).
    cmd="${cmd:-.asd-dev/bin/asd-dev} --from=unix"
    for a in "$@"; do cmd+=" $(printf '%q' "$a")"; done
    ssh -n ${SSH_ARGS[@]+"${SSH_ARGS[@]}"} -T asd-dev-login "$cmd" || rc=$?
    if ((rc == 255)); then
        echo "asd-dev: ssh to the login node failed (see above). Timed out? Off campus you need the UW VPN." >&2
        echo "         Permission denied or an unknown host? Run ./setup.sh again." >&2
    fi
    return "$rc"
}

unexpected() { echo "asd-dev: ERROR: unexpected argument '$1'; to name a session use --name $1" >&2; exit 1; }
need_value() { (($# >= 2)) || { echo "asd-dev: ERROR: $1 needs a value" >&2; exit 1; }; } # need_value "$@"

alias_for() { if [[ -z $1 || $1 == default ]]; then printf 'asd-dev-session'; else printf 'asd-dev-session-%s' "$1"; fi; }

open_code() { # open_code HOST_ALIAS FOLDER
    local alias=$1 folder=$2 user
    if [[ -z $folder ]]; then
        user=$(ssh -n ${SSH_ARGS[@]+"${SSH_ARGS[@]}"} -T -G "$alias" 2>/dev/null | awk '$1 == "user" { print $2; exit }')
        folder="/home/$user"
    fi
    local uri="vscode-remote://ssh-remote+$alias$folder"
    if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
        echo "In VS Code on Windows: Remote Explorer > SSH > $alias > Connect"
        return
    fi
    if command -v code >/dev/null 2>&1; then
        echo "Opening VS Code: $uri"
        code --folder-uri "$uri"
    else
        echo "VS Code's 'code' command is not on your PATH. In VS Code: Remote Explorer > SSH > $alias > Connect"
        [[ $(uname -s) == Darwin ]] && echo "(To add it: in VS Code press F1 and run 'Shell Command: Install 'code' command in PATH'.)"
        return 0
    fi
}

# A named session needs its own host entry before ssh or VS Code can reach it.
ensure_host() { # ensure_host NAME
    # Entries from before the per-session layout pass %h, which a crafted host name could abuse.
    if ssh -n ${SSH_ARGS[@]+"${SSH_ARGS[@]}"} -T -G asd-dev-session 2>/dev/null | grep -qE "^proxycommand .*asd-dev proxy ('%h'|%h)"; then
        echo "asd-dev: your ssh config has asd-dev entries from an earlier version; run ./setup.sh again (it keeps your settings)." >&2
        exit 1
    fi
    [[ -n $1 && $1 != default ]] || return 0
    if ! ssh -n ${SSH_ARGS[@]+"${SSH_ARGS[@]}"} -T -G "asd-dev-session-$1" 2>/dev/null | grep -q '^proxycommand '; then
        local cfg=()
        [[ -n ${ASD_DEV_SSH_CONFIG:-} ]] && cfg=(--ssh-config "$ASD_DEV_SSH_CONFIG")
        "$REPO_DIR/setup.sh" --add-session "$1" ${cfg[@]+"${cfg[@]}"} >&2
    fi
}

cmd_start() {
    local args=() no_code=no folder="" out alias name=""
    while (($#)); do
        case $1 in
            --no-code) no_code=yes ;;
            --folder) need_value "$@"; folder=$2; shift ;;
            --folder=*) folder=${1#*=} ;;
            --name) need_value "$@"; name=$2; args+=("$1" "$2"); shift ;;
            --name=*) name=${1#*=}; args+=("$1") ;;
            # Session options go to the cluster helper, which checks them.
            *) args+=("$1") ;;
        esac
        shift
    done
    ensure_host "$name"
    out=$(remote start ${args[@]+"${args[@]}"}) || exit $?
    alias=$(printf '%s\n' "$out" | awk '$1 == "ASD_DEV_READY" { print $2 }' | tail -n1)
    [[ -n $alias ]] || exit 1
    if [[ $no_code == no ]]; then open_code "$alias" "$folder"; fi
}

cmd_code() {
    local name="" folder=""
    while (($#)); do
        case $1 in
            --folder) need_value "$@"; folder=$2; shift ;;
            --name) need_value "$@"; name=$2; shift ;;
            -*) echo "unknown option $1" >&2; exit 1 ;;
            *) unexpected "$1" ;;
        esac
        shift
    done
    ensure_host "$name"
    open_code "$(alias_for "$name")" "$folder"
}

cmd_ssh() {
    local name=""
    if [[ ${1:-} == --name ]]; then need_value "$@"; name=$2; shift 2; fi
    ensure_host "$name"
    exec ssh ${SSH_ARGS[@]+"${SSH_ARGS[@]}"} "$(alias_for "$name")" "$@"
}

cmd_add() {
    case ${1:-} in
        --name) need_value "$@"; ensure_host "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ;;
        "" | -*) usage >&2; exit 1 ;;
        *) unexpected "$1" ;;
    esac
}

main() {
    local cmd=${1:-help}
    shift || true
    case $cmd in
        start) cmd_start "$@" ;;
        code | open) cmd_code "$@" ;;
        ssh | shell) cmd_ssh "$@" ;;
        add) cmd_add "$@" ;;
        stop | status | logs | log | config | version) remote "$cmd" "$@" ;;
        setup) exec "$REPO_DIR/setup.sh" "$@" ;;
        help | -h | --help) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"

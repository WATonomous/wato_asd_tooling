#!/bin/bash
# asd-dev: VS Code dev sessions inside WATcloud SLURM jobs (cluster side).
#
# setup.sh / setup.ps1 install this file as ~/.asd-dev/bin/asd-dev on the cluster. It is
#  - the ProxyCommand target on the login node ("asd-dev proxy"): finds or starts your session job
#    and connects VS Code's ssh to the sshd running inside it;
#  - the session job itself ("asd-dev _job", submitted with sbatch);
#  - the user CLI: start, stop, status, logs, config. Run "asd-dev help".
#
# Keep this file ASCII-only: setup.ps1 uploads it from Windows.
set -o errexit -o nounset -o pipefail

ASD_DEV_VERSION=2.0.0-rc.1
# Bumped on every change; install refuses to replace a newer helper with an older one.
ASD_DEV_SERIAL=14

# The install dir is ~/.asd-dev unless setup was given --cluster-dir (e.g. two installs side by side).
# Inside the job $0 is SLURM's copy of this script, so the job gets ASD_DEV_ROOT from sbatch.
if [[ -n ${ASD_DEV_ROOT:-} ]]; then
    ROOT=$ASD_DEV_ROOT
else
    case $0 in
        */bin/asd-dev | */tmp/asd-dev.new) ROOT=$(cd "$(dirname "$0")/.." && pwd) ;;
        *) ROOT="$HOME/.asd-dev" ;;
    esac
fi
CONFIG="${ASD_DEV_CONFIG:-$ROOT/config}" # override for tests
# Jobs carry the install in their comment, so two installs (setup --cluster-dir) never see each other's.
INSTALL_ID=$(basename "$ROOT")
JOB_COMMENT="asd-dev:$INSTALL_ID"
SESSIONS="$ROOT/sessions"
LOGS="$ROOT/logs"
HOSTKEY="$ROOT/ssh_host_ed25519_key"
JOB_PREFIX=wato_slurm_dev
DOCKER_STATE_ROOT=/mnt/wato-drive/slurm-docker-sessions
CLUSTER_DOMAIN=cluster.watonomous.ca

export PATH="/opt/slurm/bin:$PATH"

declare -A CFG=(
    [cpus]=4
    [mem]=16G
    [time]=6:00:00
    [tmpdisk]=32768
    [vram]=0
    [gpus]=0
    [gpu_type]=""
    [partition]=""
    [auto_start]=yes
    [auto_start_cooldown]=180
    [idle_timeout]=60
    [docker_state]=yes
    [connect_wait]=12
)
CFG_KEYS=(cpus mem time tmpdisk vram gpus gpu_type partition auto_start auto_start_cooldown idle_timeout docker_state connect_wait)

# ---------------------------------------------------------------- output helpers

# All human-readable output goes to stderr: in "proxy" mode stdout is the ssh byte stream.
say() { printf 'asd-dev: %s\n' "$*" >&2; }
die() {
    printf 'asd-dev: ERROR: %s\n' "$1" >&2
    shift
    local line
    for line in "$@"; do printf '         %s\n' "$line" >&2; done
    exit 1
}

# ---------------------------------------------------------------- config

valid_value() {
    local key=$1 value=$2
    case $key in
        cpus | tmpdisk | gpus) [[ $value =~ ^[0-9]+$ ]] ;;
        vram | idle_timeout | connect_wait | auto_start_cooldown) [[ $value =~ ^[0-9]+$ ]] ;;
        mem) [[ $value =~ ^[0-9]+[KMGT]?$ ]] ;;
        time) [[ $value =~ ^([0-9]+-)?[0-9]+(:[0-9]{1,2}){0,2}$ ]] ;;
        gpu_type | partition) [[ $value =~ ^[A-Za-z0-9_]*$ ]] ;;
        auto_start | docker_state) [[ $value == yes || $value == no ]] ;;
        *) return 1 ;;
    esac
}

is_config_key() {
    local k
    for k in "${CFG_KEYS[@]}"; do [[ $k == "$1" ]] && return 0; done
    return 1
}

# Applies "key=value" words to CFG. $1 is a label used in error messages.
apply_settings() {
    local origin=$1 kv key value
    shift
    for kv in "$@"; do
        [[ $kv == *=* ]] || die "$origin: expected key=value, got '$kv'"
        key=${kv%%=*}
        value=${kv#*=}
        is_config_key "$key" || die "$origin: unknown setting '$key'" "Known settings: ${CFG_KEYS[*]}"
        valid_value "$key" "$value" || die "$origin: invalid value for $key: '$value'"
        CFG[$key]=$value
    done
}

load_config() {
    [[ -f $CONFIG ]] || return 0
    local line settings=()
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        line=${line//[[:space:]]/}
        [[ -n $line ]] && settings+=("$line")
    done <"$CONFIG"
    if ((${#settings[@]})); then apply_settings "$CONFIG" "${settings[@]}"; fi
}

write_config_value() {
    local key=$1 value=$2 tmp
    tmp=$(mktemp "$CONFIG.XXXXXX")
    # Keeps the line's comment, which explains the setting.
    awk -v k="$key" -v v="$value" '
        BEGIN { done = 0 }
        $0 ~ "^[[:space:]]*" k "[[:space:]]*=" {
            if (!done) {
                c = index($0, "#"); line = k "=" v
                if (c) { comment = substr($0, c); pad = 22 - length(line); if (pad < 1) pad = 1
                         line = line sprintf("%" pad "s", "") comment }
                print line
            }
            done = 1; next
        }
        { print }
        END { if (!done) print k "=" v }' "$CONFIG" >"$tmp"
    mv -f "$tmp" "$CONFIG"
}

create_default_config() {
    cat >"$CONFIG" <<'EOF'
# asd-dev defaults for new sessions. Edit freely, or run: asd-dev config key=value
# One-off overrides: asd-dev start --cpus 8 --vram 8192 ...
cpus=4                # CPU cores
mem=16G               # RAM
time=6:00:00          # time limit (WATcloud asks interactive work to stay within 6 hours)
tmpdisk=32768         # MiB of job-local /tmp, where docker images live; above ~66000 some nodes cannot run it
vram=0                # MiB of GPU memory as a shared GPU slice ("shard"); 0 = no GPU
gpus=0                # whole GPUs instead of a slice (overrides vram when > 0)
gpu_type=             # e.g. rtx_3090; empty = any
partition=            # empty = cluster default
auto_start=yes        # connecting from VS Code starts a session when none is running
auto_start_cooldown=180 # ...but not within this many minutes after one ended other than by idle_timeout,
                      # because VS Code keeps reconnecting by itself for hours (asd-dev start always works)
idle_timeout=60       # minutes without any connection (and no tmux/screen) before the session stops; 0 = never
docker_state=yes      # restore docker images/containers at start, save them when the session stops
connect_wait=12       # seconds VS Code's connection waits for a starting session (VS Code gives up at 15)
EOF
}

describe_resources() {
    local gpu="no GPU"
    if ((CFG[gpus] > 0)); then
        gpu="${CFG[gpus]} GPU(s)${CFG[gpu_type]:+ (${CFG[gpu_type]})}"
    elif ((CFG[vram] > 0)); then
        gpu="${CFG[vram]} MiB GPU slice${CFG[gpu_type]:+ (${CFG[gpu_type]})}"
    fi
    printf '%s CPUs, %s RAM, %s MiB /tmp, %s, time limit %s' \
        "${CFG[cpus]}" "${CFG[mem]}" "${CFG[tmpdisk]}" "$gpu" "${CFG[time]}"
}

gres_string() {
    local gres="tmpdisk:${CFG[tmpdisk]}" type=""
    [[ -n ${CFG[gpu_type]} ]] && type="${CFG[gpu_type]}:"
    if ((CFG[gpus] > 0)); then
        gres+=",gpu:$type${CFG[gpus]}"
    elif ((CFG[vram] > 0)); then
        gres+=",shard:$type${CFG[vram]}"
    fi
    printf '%s' "$gres"
}

# ---------------------------------------------------------------- session naming

# VS Code host alias -> session name: asd-dev-session -> default, asd-dev-session-<name> -> <name>.
session_from_alias() {
    local alias=${1,,}
    case $alias in
        asd-dev-session-?*) printf '%s' "${alias#asd-dev-session-}" ;;
        *) printf 'default' ;;
    esac
}

check_name() {
    [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,19}$ ]] ||
        die "invalid session name '$1'" "Use up to 20 lowercase letters, digits, '-' or '_'."
}

start_cmd() { if [[ $1 == default ]]; then printf 'asd-dev start'; else printf 'asd-dev start %s' "$1"; fi; }
stop_cmd() { if [[ $1 == default ]]; then printf 'asd-dev stop'; else printf 'asd-dev stop %s' "$1"; fi; }
job_name() { if [[ $1 == default ]]; then printf '%s' "$JOB_PREFIX"; else printf '%s' "$JOB_PREFIX-$1"; fi; }
host_alias() { if [[ $1 == default ]]; then printf 'asd-dev-session'; else printf 'asd-dev-session-%s' "$1"; fi; }
name_from_job_name() { if [[ $1 == "$JOB_PREFIX" ]]; then printf 'default'; else printf '%s' "${1#"$JOB_PREFIX"-}"; fi; }

# ---------------------------------------------------------------- SLURM queries

SQ_FORMAT='%i|%T|%N|%r|%k|%L|%S|%j'

# The default install also owns jobs of earlier versions (comment "asd-dev") and of the old
# start_interactive_session.sh (no comment), which other installs must not touch.
is_default_install() { [[ $INSTALL_ID == .asd-dev ]]; }
is_legacy_comment() { [[ -z $1 || $1 == "(null)" ]]; }

# Keeps the SQ_FORMAT lines (stdin) of jobs that belong to this install.
own_jobs_filter() {
    local dflt=no
    is_default_install && dflt=yes
    awk -F'|' -v mine="$JOB_COMMENT" -v dflt="$dflt" '
        NF >= 8 && $2 != "COMPLETING" && $2 != "COMPLETED" &&
        ($5 == mine || (dflt == "yes" && ($5 == "asd-dev" || $5 == "(null)" || $5 == "")))'
}

# Prints this install's active jobs for session $1, oldest first, as SQ_FORMAT lines.
session_jobs() {
    local out
    if ! out=$(squeue --me -h --name="$(job_name "$1")" --sort=i -o "$SQ_FORMAT" 2>&1 </dev/null); then
        die "could not ask SLURM for your jobs (squeue failed):" "$out" \
            "The SLURM controller may be down; check https://status.watonomous.ca"
    fi
    printf '%s\n' "$out" | own_jobs_filter
}

# Sets J_* globals from a line that starts with the SQ_FORMAT fields.
parse_job() {
    IFS='|' read -r J_ID J_STATE J_NODE J_REASON J_COMMENT J_LEFT J_START J_NAME _ <<<"$1"
}

# Picks the oldest active job of session $1 into J_*; returns 1 if there is none.
# Oldest, so every proxy agrees on the same job when duplicates exist (see dedupe_after_submit).
find_session_job() {
    local name=$1 jobs count
    jobs=$(session_jobs "$name") || exit 1
    [[ -n $jobs ]] || return 1
    count=$(printf '%s\n' "$jobs" | wc -l)
    parse_job "$(printf '%s\n' "$jobs" | head -n1)"
    if ((count > 1)); then
        say "WARNING: you have $count '$name' sessions ($(printf '%s\n' "$jobs" | cut -d'|' -f1 | tr '\n' ' ')); using the oldest, job $J_ID."
        say "         Stop the others with: asd-dev stop --job <id>"
    fi
}

refresh_job() {
    local line
    if line=$(squeue -h -j "$J_ID" -o "$SQ_FORMAT" 2>&1 </dev/null); then
        if [[ -n $line ]]; then parse_job "$line"; else J_STATE=GONE; fi
    elif [[ $line == *"Invalid job id"* ]]; then
        J_STATE=GONE
    fi
    # Any other squeue failure (controller hiccup): keep the last known state and retry.
}

# Explains a SLURM pending reason in plain words. Returns 1 when the job cannot start as requested.
explain_reason() {
    case $1 in
        None | "") echo "waiting for the scheduler" ;;
        Resources) echo "waiting for free resources: the cluster is busy, it starts when enough is free" ;;
        Priority) echo "waiting in the queue: other jobs are ahead of yours" ;;
        QOSMax* | AssocMax* | AssocGrp* | QOSGrp* | MaxCpuPerAccount | MaxGRESPerAccount | MaxMemPerLimit)
            echo "held back by your per-user limit ($1): your other jobs already use your share; stop some (squeue --me) or ask for less"
            ;;
        ReqNodeNotAvail* | PartitionDown | NodeDown) echo "the nodes that fit this request are unavailable right now ($1)" ;;
        PartitionTimeLimit) echo "the time limit is longer than the partition allows ($1)"; return 1 ;;
        BadConstraints | PartitionConfig | InvalidQOS | InvalidAccount | QOSJobLimit) echo "SLURM cannot run this request ($1)"; return 1 ;;
        JobHeld* | launch_failed_requeued_held) echo "held by SLURM ($1)"; return 1 ;;
        *) echo "pending ($1)" ;;
    esac
}

# ---------------------------------------------------------------- session state files

state_file() { printf '%s/%s.env' "$SESSIONS" "$1"; }

# Reads the session state written by the job into S_* globals; returns 1 if missing.
read_state() {
    local f key value
    f=$(state_file "$1")
    S_NODE="" S_ADDR="" S_PORT=""
    [[ -f $f ]] || return 1
    while IFS='=' read -r key value; do
        case $key in
            node) S_NODE=$value ;;
            addr) S_ADDR=$value ;;
            port) S_PORT=$value ;;
        esac
    done <"$f"
    [[ -n $S_PORT && -n $S_NODE ]]
}

is_stopping() { [[ -e $SESSIONS/$1.stopping || -e $SESSIONS/$1.stop ]]; }

# Writes how session NAME's job ended (or "running" at its start) to sessions/last-NAME.
# The cooldown reads only these records, so jobs of other installs or of the old tooling never count.
write_end_record() { # write_end_record NAME JOB REASON KIND
    local tmp
    mkdir -p "$SESSIONS"
    tmp=$(mktemp "$SESSIONS/.last-$1.XXXXXX")
    printf 'job=%s\nended_epoch=%s\nreason=%s\nkind=%s\n' "$2" "$(date +%s)" "$3" "$4" >"$tmp"
    mv -f "$tmp" "$SESSIONS/last-$1"
}

# Reads how this install's last session $1 (or, without $1, its most recent one) ended.
# Sets L_ID L_NAME L_KIND (idle|stop|cancel|timeout|fail|ending) L_TEXT L_WHEN L_AGE (minutes).
# Returns 1 if there is no record.
last_end() {
    local name=${1:-} f key value epoch="" state end
    L_ID="" L_NAME="" L_KIND="" L_TEXT="" L_WHEN="" L_AGE=0
    if [[ -n $name ]]; then
        f=$SESSIONS/last-$name
    else
        # shellcheck disable=SC2012 # our own file names, newest first
        f=$(ls -t "$SESSIONS"/last-* 2>/dev/null | head -n1 || true)
    fi
    [[ -n $f && -f $f ]] || return 1
    L_NAME=${f##*/last-}
    while IFS='=' read -r key value; do
        case $key in
            job) L_ID=$value ;;
            ended_epoch) epoch=$value ;;
            ended) epoch=${epoch:-$(date -d "$value" +%s 2>/dev/null || true)} ;;
            reason) L_TEXT=$value ;;
            kind) L_KIND=$value ;;
        esac
    done <"$f"
    [[ $L_ID =~ ^[0-9]+$ ]] || return 1
    # "running" (written at start) and "slurm" (SIGTERM) mean SLURM ended it; ask sacct how.
    if [[ $L_KIND == running || $L_KIND == slurm ]]; then
        IFS='|' read -r state end < <(sacct -j "$L_ID" -X -n -P -o State,End 2>/dev/null </dev/null || true)
        case ${state:-} in
            TIMEOUT*) L_KIND=timeout L_TEXT="it reached its time limit" ;;
            CANCELLED*) L_KIND=cancel L_TEXT="it was cancelled (asd-dev stop --now or scancel)" ;;
            OUT_OF_ME*) L_KIND=fail L_TEXT="it ran out of memory (ask for more: asd-dev start --mem 32G)" ;;
            NODE_FAIL*) L_KIND=fail L_TEXT="its node failed" ;;
            RUNNING* | COMPLETING* | PENDING* | "") L_KIND=ending L_TEXT="it is still shutting down" ;;
            *) L_KIND=fail L_TEXT="it ended unexpectedly ($state; see: asd-dev logs $L_NAME)" ;;
        esac
        if [[ $L_KIND != ending && -n ${end:-} ]]; then epoch=$(date -d "$end" +%s 2>/dev/null || echo "$epoch"); fi
        [[ $L_KIND == ending ]] && epoch=$(date +%s)
    fi
    if [[ $epoch =~ ^[0-9]+$ ]]; then
        L_WHEN="at $(date -u -d "@$epoch" '+%H:%M') UTC"
        L_AGE=$((($(date +%s) - epoch) / 60))
    fi
}

# True while the cooldown after session $1's last end applies (set by last_end).
in_cooldown() { [[ -n $L_ID && $L_KIND != idle ]] && ((L_AGE < CFG[auto_start_cooldown])); }

# shellcheck disable=SC2088 # printed for the user to type
login_cmd() { printf '~/%s/bin/%s' "$INSTALL_ID" "$1"; }

ago() { if (($1 < 1)); then echo "just now"; elif (($1 < 120)); then echo "$1 min ago"; else echo "$(($1 / 60)) h ago"; fi; }

# Prints why the last session $1 (or any session) ended, if one ended recently.
explain_last_end() {
    last_end "${1:-}" || return 0
    say "your last '$L_NAME' session (job $L_ID) ended $(ago "$L_AGE")${L_WHEN:+ ($L_WHEN)}: $L_TEXT."
}

# ---------------------------------------------------------------- starting and waiting

submit_session() {
    local name=$1 started_by=$2 out args
    mkdir -p "$LOGS" "$SESSIONS"
    [[ -f $HOSTKEY ]] || die "the session host key $HOSTKEY is missing." "Run the setup script on your laptop again."
    # shellcheck disable=SC2054 # the comma belongs to --export's value
    args=(
        --parsable
        --job-name="$(job_name "$name")"
        --comment="$JOB_COMMENT"
        --chdir="$HOME"
        --output="$LOGS/%j.log"
        --cpus-per-task="${CFG[cpus]}"
        --mem="${CFG[mem]}"
        --time="${CFG[time]}"
        --gres="$(gres_string)"
        --signal=B:USR1@600
        --export=ALL,ASD_DEV_ROOT="$ROOT"
    )
    [[ -n ${CFG[partition]} ]] && args+=(--partition="${CFG[partition]}")
    # --export=ALL would carry GPU and SLURM variables of a session this runs in into the new job.
    local v unset=()
    for v in $(compgen -v SLURM_) CUDA_VISIBLE_DEVICES GPU_DEVICE_ORDINAL ROCR_VISIBLE_DEVICES ASD_DEV_SESSION; do
        [[ $v == SLURM_CONF ]] || unset+=(-u "$v")
    done
    if ! out=$(env "${unset[@]}" sbatch "${args[@]}" "$ROOT/bin/asd-dev" _job "$name" \
        "idle_timeout=${CFG[idle_timeout]}" "docker_state=${CFG[docker_state]}" "started_by=$started_by" 2>&1 </dev/null); then
        die "SLURM rejected the session job:" "$out" "Requested: $(describe_resources)"
    fi
    J_ID=$(printf '%s\n' "$out" | grep -Eo '^[0-9]+' | tail -n1)
    [[ -n $J_ID ]] || die "could not read the job id from sbatch output:" "$out"
    J_STATE=PENDING J_NODE="" J_REASON=None J_COMMENT=$JOB_COMMENT J_NAME=$(job_name "$name") J_DEDUPED=no
    dedupe_after_submit "$name"
}

# The lock only serializes proxies on one login node. If a proxy on another node (or computer)
# submitted the same session at the same moment, the job with the lower id wins: the later
# submitter always sees the earlier job, cancels its own and uses that one.
dedupe_after_submit() {
    local name=$1 jobs oldest
    jobs=$(session_jobs "$name") || return 0
    oldest=$(printf '%s\n' "$jobs" | head -n1 | cut -d'|' -f1)
    if [[ -n $oldest && $oldest != "$J_ID" ]]; then
        scancel "$J_ID" </dev/null || true
        say "another connection started '$name' at the same moment (job $oldest); using it and cancelling job $J_ID."
        parse_job "$(printf '%s\n' "$jobs" | head -n1)"
        J_DEDUPED=yes
    fi
}

# Waits until session job J_ID accepts ssh connections, printing progress.
# $1 = deadline in $SECONDS (0 = no deadline). Sets S_ADDR/S_PORT. Returns 1 on timeout.
wait_ready() {
    local deadline=$1 msg last_msg="" why running_since=""
    while true; do
        refresh_job
        case $J_STATE in
            PENDING | CONFIGURING | REQUEUED | RESIZING)
                if [[ $J_STATE == CONFIGURING ]]; then
                    msg="job $J_ID is being set up on $J_NODE"
                elif why=$(explain_reason "$J_REASON"); then
                    msg="job $J_ID is $why"
                    [[ $J_START != N/A && -n $J_START ]] && msg+=" (SLURM's estimated start: $J_START UTC)"
                else
                    die "job $J_ID cannot start: $why" "Stop it with: asd-dev stop --job $J_ID"
                fi
                ;;
            RUNNING)
                running_since=${running_since:-$SECONDS}
                if is_stopping "$J_ID"; then
                    die "job $J_ID is stopping (it saves docker state first if that is on), so there is nothing to connect to." \
                        "Connect again once it has ended, or run on your laptop: ./$(start_cmd "$(name_from_job_name "$J_NAME")")" \
                        "(that waits for the old session to end and then starts a new one)."
                fi
                # The job writes its state file only once sshd listens, so no probe is needed
                # (a probe would also leave "Connection closed" noise in the session log).
                if read_state "$J_ID"; then
                    return 0
                elif is_legacy_comment "$J_COMMENT"; then
                    # Started by the old start_interactive_session.sh: sshd on the fixed port, no state file.
                    S_NODE=$J_NODE S_ADDR="" S_PORT=$(($(id -u) * 20 - 1))
                    if nc -z -w 3 "$S_NODE.$CLUSTER_DOMAIN" "$S_PORT" </dev/null 2>/dev/null; then
                        say "connecting to job $J_ID, which the old start_interactive_session.sh started."
                        say "In it, docker needs: export DOCKER_HOST=unix:///tmp/run/docker.sock (stop it and connect again for a new-style session)."
                        return 0
                    fi
                    msg="job $J_ID (started by the old tooling) runs on $J_NODE, but nothing listens on port $S_PORT"
                else
                    msg="job $J_ID is starting on $J_NODE"
                fi
                if ((SECONDS - running_since > 90)); then
                    die "$msg after 90 seconds; the session did not come up." \
                        "Its log: $LOGS/$J_ID.log (or run: asd-dev logs)" \
                        "Then stop it with: asd-dev stop --job $J_ID"
                fi
                ;;
            GONE | COMPLETED | CANCELLED | FAILED | TIMEOUT | NODE_FAIL | PREEMPTED | OUT_OF_MEMORY | BOOT_FAIL | DEADLINE)
                die "job $J_ID ended before it was ready ($J_STATE)." "Its log: $LOGS/$J_ID.log (or run: asd-dev logs)"
                ;;
            *) msg="job $J_ID is $J_STATE" ;;
        esac
        if [[ $msg != "$last_msg" ]]; then
            say "$msg"
            last_msg=$msg
        fi
        if ((deadline > 0 && SECONDS >= deadline)); then
            return 1
        fi
        sleep 1
    done
}

# Serializes "find or submit" so two VS Code windows connecting at once do not start two jobs.
take_lock() {
    local f
    f="${XDG_RUNTIME_DIR:-/tmp}/asd-dev-$(id -u)-$(basename "$ROOT").lock"
    if { exec 9>>"$f"; } 2>/dev/null; then
        flock -w 20 9 || say "WARNING: could not lock $f; continuing without it"
    fi
}
release_lock() { exec 9>&-; }

# ---------------------------------------------------------------- commands: proxy, start

cmd_proxy() {
    local alias=${1:-asd-dev-session} name deadline
    name=$(session_from_alias "$alias")
    check_name "$name"
    load_config
    deadline=$((SECONDS + CFG[connect_wait]))
    take_lock
    if ! find_session_job "$name"; then
        last_end "$name" || true
        if [[ ${CFG[auto_start]} != yes ]]; then
            release_lock
            explain_last_end "$name"
            die "you have no '$name' session running, so there is nothing to connect to." \
                "Start one on your laptop with: ./$(start_cmd "$name")   (it opens VS Code when ready)" \
                "or let VS Code start it for you: asd-dev config auto_start=yes"
        fi
        # VS Code retries a lost connection for hours and reopens remote windows at launch; without
        # this, a session ending by time limit or stop would be followed by job after job.
        if in_cooldown; then
            release_lock
            # The first line must stand alone: users scanning VS Code's log may read nothing else.
            die "no session started. Run ./$(start_cmd "$name") on your laptop (it opens VS Code), then Retry." \
                "Why: your last '$name' session ended $(ago "$L_AGE") ($L_TEXT), and VS Code keeps" \
                "reconnecting on its own after a session ends, so connecting does not start a new one" \
                "for ${CFG[auto_start_cooldown]} min (asd-dev config auto_start_cooldown=...)." \
                "On the login node instead: $(login_cmd "$(start_cmd "$name")")"
        fi
        explain_last_end "$name"
        submit_session "$name" vscode
        if [[ $J_DEDUPED == no ]]; then
            say "no '$name' session was running, so I started one: job $J_ID ($(describe_resources))."
            say "It stops by itself after ${CFG[idle_timeout]} min with nothing connected; stop it sooner with: $(stop_cmd "$name")"
        fi
    fi
    release_lock
    if ! wait_ready "$deadline"; then
        die "the session is not ready yet (see the line above); it stays queued and starts on its own." \
            "Click Retry in VS Code in a minute, or wait for it in a terminal with: $(start_cmd "$name")"
    fi
    local addr=${S_ADDR:-$S_NODE.$CLUSTER_DOMAIN} started=$SECONDS rc=0
    # Marks activity for the idle stop, which samples open connections only once a minute.
    touch "$SESSIONS/$J_ID.seen" 2>/dev/null || true
    nc -N "$addr" "$S_PORT" || rc=$?
    # A quick failure means nothing answered; a late one is just the end of a connection.
    if ((rc != 0 && SECONDS - started < 5)); then
        die "could not reach the session's ssh server ($addr port $S_PORT on $S_NODE, job $J_ID)." \
            "It restarts by itself if it crashed; retry in a few seconds. Its log: asd-dev logs $name"
    fi
    exit "$rc"
}

# Parses start/stop flags into FLAG_SETTINGS (key=value words) and NAME.
parse_session_flags() {
    # Inside a session, "asd-dev stop" means this session (sshd's SetEnv provides ASD_DEV_SESSION).
    NAME=${ASD_DEV_SESSION:-default} FLAG_SETTINGS=() FLAG_NOW=no FLAG_JOB="" FLAG_ALL=no FLAG_FOLLOW=no
    while (($#)); do
        case $1 in
            --name | -n) NAME=${2:?--name needs a value}; shift ;;
            --cpus) FLAG_SETTINGS+=("cpus=${2:?}"); shift ;;
            --mem) FLAG_SETTINGS+=("mem=${2:?}"); shift ;;
            --time) FLAG_SETTINGS+=("time=${2:?}"); shift ;;
            --tmpdisk) FLAG_SETTINGS+=("tmpdisk=${2:?}"); shift ;;
            --vram) FLAG_SETTINGS+=("vram=${2:?}" "gpus=0"); shift ;;
            --gpus) FLAG_SETTINGS+=("gpus=${2:?}"); shift ;;
            --gpu-type) FLAG_SETTINGS+=("gpu_type=${2:?}"); shift ;;
            --no-gpu) FLAG_SETTINGS+=("gpus=0" "vram=0") ;;
            --partition) FLAG_SETTINGS+=("partition=${2:?}"); shift ;;
            --idle-timeout) FLAG_SETTINGS+=("idle_timeout=${2:?}"); shift ;;
            --docker-state) FLAG_SETTINGS+=("docker_state=yes") ;;
            --no-docker-state) FLAG_SETTINGS+=("docker_state=no") ;;
            --now) FLAG_NOW=yes ;;
            --all) FLAG_ALL=yes ;;
            --job) FLAG_JOB=${2:?--job needs a job id}; shift ;;
            -f | --follow) FLAG_FOLLOW=yes ;;
            -h | --help) usage; exit 0 ;;
            -*) die "unknown option '$1'" "Run: asd-dev help" ;;
            *) NAME=$1 ;;
        esac
        shift
    done
    check_name "$NAME"
}

# Waits until job $1 has left the queue.
wait_job_gone() {
    local id=$1 waited=0
    while squeue -h -j "$id" -t PD,CF,R,CG,S -o %T 2>/dev/null </dev/null | grep -q .; do
        sleep 3
        waited=$((waited + 3))
        if ((waited % 60 == 0)); then say "still stopping ($waited s)..."; fi
        if ((waited >= 900)); then return 1; fi
    done
}

cmd_start() {
    parse_session_flags "$@"
    load_config
    if ((${#FLAG_SETTINGS[@]})); then apply_settings "command line" "${FLAG_SETTINGS[@]}"; fi
    take_lock
    if find_session_job "$NAME" && [[ $J_STATE == RUNNING ]] && is_stopping "$J_ID"; then
        release_lock
        say "your '$NAME' session (job $J_ID) is stopping (saving docker state first if that is on); waiting for it to end..."
        wait_job_gone "$J_ID" || die "job $J_ID did not end within 15 minutes; cancel it with: asd-dev stop --job $J_ID --now"
        take_lock
    fi
    J_DEDUPED=no
    if find_session_job "$NAME"; then
        release_lock
        say "your '$NAME' session already exists (job $J_ID, $J_STATE${J_NODE:+ on $J_NODE})."
        if ((${#FLAG_SETTINGS[@]})); then
            say "It keeps the resources it was started with. To change them: $(stop_cmd "$NAME"), then start again."
        fi
    else
        submit_session "$NAME" start
        release_lock
        say "submitted job $J_ID: $(describe_resources)"
    fi
    trap 'say "stopped waiting; job $J_ID keeps going. Check it with: asd-dev status   cancel it with: asd-dev stop"; exit 130' INT
    wait_ready 0
    trap - INT
    refresh_job
    say "ready: session '$NAME' runs on $J_NODE (job $J_ID, $J_LEFT left)."
    say "Connect: VS Code > Remote Explorer > SSH > $(host_alias "$NAME") > Connect   (terminal: ssh $(host_alias "$NAME"))"
    printf 'ASD_DEV_READY %s %s\n' "$(host_alias "$NAME")" "$J_ID"
}

# ---------------------------------------------------------------- commands: stop, status, logs

stop_job() {
    local id=$1 state=$2 node=$3 comment=$4 name hint
    name=$(name_from_job_name "$J_NAME")
    hint="Connecting from VS Code will not start a new session for ${CFG[auto_start_cooldown]} min; for one sooner: $(start_cmd "$name")"
    # Jobs of the old start_interactive_session.sh do not watch for the stop file.
    if [[ $state != RUNNING || $FLAG_NOW == yes ]] || is_legacy_comment "$comment"; then
        scancel "$id" </dev/null
        if [[ $state != RUNNING ]]; then
            # It never ran, so it wrote no record; without one the cooldown would not apply.
            write_end_record "$name" "$id" "it was cancelled before it started" cancel
            say "cancelled job $id (it had not started)."
        else
            say "cancelled job $id."
        fi
        say "$hint"
        return
    fi
    mkdir -p "$SESSIONS"
    : >"$SESSIONS/$id.stop"
    if [[ ${SLURM_JOB_ID:-} == "$id" ]]; then
        say "stopping this session (job $id). It saves docker state if enabled, then this window disconnects."
        say "$hint"
        return
    fi
    say "stopping job $id on $node (saving docker state first if enabled; this can take a few minutes)..."
    say "$hint"
    if ! wait_job_gone "$id"; then
        say "job $id did not stop within 15 minutes; cancelling it."
        scancel "$id" </dev/null
        return
    fi
    say "job $id stopped."
}

cmd_stop() {
    parse_session_flags "$@"
    load_config
    local lines line
    if [[ -n $FLAG_JOB ]]; then
        line=$(squeue --me -h -j "$FLAG_JOB" -o "$SQ_FORMAT" 2>/dev/null </dev/null || true)
        [[ -n $line ]] || die "job $FLAG_JOB is not one of your active jobs."
        [[ -n $(printf '%s\n' "$line" | own_jobs_filter) ]] ||
            die "job $FLAG_JOB is not a session of this install ($ROOT)." \
                "Stop it with the install that started it, or with scancel $FLAG_JOB."
        parse_job "$line"
        [[ $J_NAME == "$JOB_PREFIX"* ]] || die "job $FLAG_JOB ($J_NAME) is not an asd-dev session; use scancel for other jobs."
        stop_job "$J_ID" "$J_STATE" "$J_NODE" "$J_COMMENT"
        return
    fi
    if [[ $FLAG_ALL == yes ]]; then
        lines=$(all_session_jobs)
    else
        lines=$(session_jobs "$NAME")
    fi
    if [[ -z $lines ]]; then
        if [[ $FLAG_ALL == yes ]]; then say "no session is running."; else say "no '$NAME' session is running."; fi
        return 0
    fi
    while IFS= read -r line; do
        parse_job "$line"
        stop_job "$J_ID" "$J_STATE" "$J_NODE" "$J_COMMENT"
    done <<<"$lines"
}

all_session_jobs() {
    squeue --me -h --sort=i -o "$SQ_FORMAT|%C|%m|%b" </dev/null |
        awk -F'|' -v p="$JOB_PREFIX" '$8 == p || index($8, p "-") == 1' | own_jobs_filter
}

# Removes per-job files of jobs that are no longer active (left behind by hard kills).
cleanup_stale() {
    local active f id
    active=" $(all_session_jobs | cut -d'|' -f1 | tr '\n' ' ') "
    for f in "$SESSIONS"/*.env "$SESSIONS"/*.seen "$SESSIONS"/*.stop "$SESSIONS"/*.stopping; do
        [[ -e $f ]] || continue
        id=${f##*/}
        id=${id%%.*}
        [[ $id =~ ^[0-9]+$ && $active != *" $id "* ]] && rm -f "$f"
    done
    return 0
}

cmd_status() {
    local lines line cpus mem gres name
    load_config
    cleanup_stale
    lines=$(all_session_jobs)
    if [[ -z $lines ]]; then
        if last_end && in_cooldown; then
            say "no session is running. Your last '$L_NAME' session ended $(ago "$L_AGE") ($L_TEXT), so for"
            say "${CFG[auto_start_cooldown]} min after that connecting from VS Code does not start one. Start one: $(start_cmd "$L_NAME")"
        else
            say "no session is running. Start one: asd-dev start   (or just connect from VS Code)"
            explain_last_end
        fi
        return 0
    fi
    printf '%-10s %-8s %-10s %-14s %-12s %s\n' SESSION JOB STATE NODE TIME_LEFT RESOURCES >&2
    while IFS= read -r line; do
        parse_job "$line"
        IFS='|' read -r cpus mem gres <<<"$(printf '%s' "$line" | cut -d'|' -f9-11)"
        name=$(name_from_job_name "$J_NAME")
        printf '%-10s %-8s %-10s %-14s %-12s %s CPUs, %s RAM, %s\n' "$name" "$J_ID" "$J_STATE" \
            "${J_NODE:-"-"}" "$J_LEFT" "$cpus" "$mem" "${gres#gres/}" >&2
        if [[ $J_STATE == PENDING ]]; then say "  job $J_ID is $(explain_reason "$J_REASON" || true)"; fi
    done <<<"$lines"
    say "Connect: VS Code > Remote Explorer > SSH > asd-dev-session (or asd-dev-session-<name>). Stop: asd-dev stop [name]"
    is_default_install || say "(sessions of the install in $ROOT only)"
}

cmd_logs() {
    parse_session_flags "$@"
    local id=$FLAG_JOB
    if [[ -z $id ]]; then
        if find_session_job "$NAME"; then
            id=$J_ID
        else
            id=$(sacct -X -n -P --name="$(job_name "$NAME")" -S now-7days -o JobID 2>/dev/null </dev/null |
                grep -E '^[0-9]+$' | tail -n1 || true)
        fi
    fi
    [[ -n $id && -f $LOGS/$id.log ]] || die "no log found for session '$NAME'${id:+ (job $id)}."
    say "log of job $id: $LOGS/$id.log"
    if [[ $FLAG_FOLLOW == yes ]]; then tail -n 50 -f "$LOGS/$id.log"; else tail -n 50 "$LOGS/$id.log"; fi
}

cmd_config() {
    mkdir -p "$ROOT"
    [[ -f $CONFIG ]] || create_default_config
    load_config
    if (($#)); then
        apply_settings "command line" "$@"
        local kv
        for kv in "$@"; do write_config_value "${kv%%=*}" "${kv#*=}"; done
        say "saved to $CONFIG"
    fi
    local k
    for k in "${CFG_KEYS[@]}"; do printf '%s=%s\n' "$k" "${CFG[$k]}"; done
}

# ---------------------------------------------------------------- command: install (run by setup)

cmd_install() {
    local src settings=() kv installed_serial
    src="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    for kv in "$@"; do settings+=("$kv"); done
    installed_serial=$(sed -n 's/^ASD_DEV_SERIAL=\([0-9]*\)$/\1/p' "$ROOT/bin/asd-dev" 2>/dev/null | head -n1 || true)
    if ((${installed_serial:-0} > ASD_DEV_SERIAL)) && [[ ${ASD_DEV_ALLOW_DOWNGRADE:-} != yes ]]; then
        printf 'ASD_DEV_NEWER_INSTALLED %s %s\n' "$(sed -n 's/^ASD_DEV_VERSION=//p' "$ROOT/bin/asd-dev" | head -n1)" "$ASD_DEV_VERSION"
        die "your cluster home has a newer asd-dev than this copy of wato_asd_tooling ($ASD_DEV_VERSION)." \
            "Update your copy (git pull in wato_asd_tooling) and run setup again."
    fi
    umask 077
    mkdir -p "$ROOT/bin" "$SESSIONS" "$LOGS"
    chmod 700 "$ROOT"
    if [[ $src != "$ROOT/bin/asd-dev" ]]; then
        cp "$src" "$ROOT/bin/asd-dev.new"
        chmod 755 "$ROOT/bin/asd-dev.new"
        mv -f "$ROOT/bin/asd-dev.new" "$ROOT/bin/asd-dev"
        [[ $src == "$ROOT/tmp/"* ]] && rm -f "$src"
    fi
    printf '%s\n' "Files of wato_asd_tooling (asd-dev): VS Code dev sessions in SLURM jobs. Run $ROOT/bin/asd-dev help" >"$ROOT/README"
    [[ -f $CONFIG ]] || create_default_config
    if ((${#settings[@]})); then
        load_config
        apply_settings "setup" "${settings[@]}"
        for kv in "${settings[@]}"; do write_config_value "${kv%%=*}" "${kv#*=}"; done
    fi
    if [[ ! -f $HOSTKEY ]]; then
        ssh-keygen -q -t ed25519 -N '' -C "asd-dev session host key" -f "$HOSTKEY" </dev/null
        # Default ACLs on some homes make it group-readable, and sshd then refuses the key.
        chmod 600 "$HOSTKEY"
    fi
    find "$LOGS" -name '*.log' -mtime +14 -delete 2>/dev/null || true
    cleanup_stale
    load_config
    say "session defaults: $(describe_resources); change them with: asd-dev config key=value"
    printf 'ASD_DEV_INSTALLED %s %s %s\n' "$ASD_DEV_VERSION" "$(id -un)" "$(id -u)"
    printf 'ASD_DEV_HOSTKEY %s\n' "$(cut -d' ' -f1,2 "$HOSTKEY.pub")"
    if [[ -f $HOME/.ssh/slurm_key.pub ]]; then
        printf 'ASD_DEV_LEGACY_HOSTKEY %s\n' "$(cut -d' ' -f1,2 "$HOME/.ssh/slurm_key.pub")"
    fi
    if [[ ! -s /etc/cluster/users/$(id -u)/.ssh/authorized_keys && ! -s $HOME/.ssh/authorized_keys ]]; then
        say "WARNING: found no registered SSH keys for you; connecting to sessions will fail."
    fi
}

# ---------------------------------------------------------------- the session job

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
human_size() { numfmt --to=iec --suffix=B "$(stat -c %s "$1")"; }

# The default install keeps the old tooling's file names; other installs get their own files.
docker_state_file() {
    local base=slurm-docker-state
    [[ $SESSION_NAME == default ]] || base+="-$SESSION_NAME"
    is_default_install || base+="-${INSTALL_ID#.}"
    printf '%s' "$DOCKER_STATE_DIR/$base.tar.zst"
}

# Docker state is used only from a directory the user owns alone.
docker_state_dir_ok() {
    local owner mode
    read -r owner mode < <(stat -c '%u %a' "$DOCKER_STATE_DIR" 2>/dev/null) || return 1
    [[ $owner == "$(id -u)" && $mode =~ [0-7][0145][0145]$ ]]
}

# Saving is safe only after a complete load: saving after a failed or partial load would replace
# the good saved state with an empty or partial one.
DOCKER_LOADED_MARK=/tmp/.asd-dev-docker-loaded
DOCKER_NOSAVE_MARK=/tmp/.asd-dev-docker-nosave
NOTICE_QUEUE=/tmp/.asd-dev-notices

# Queues a notice for the session's terminals (written once one exists, see the main loop).
queue_notice() { printf '%s\n' "$1" >>"$NOTICE_QUEUE"; }

saving_off() { # saving_off REASON TMPDISK_MIB_TO_SUGGEST
    local file again
    file=$(docker_state_file)
    : >"$DOCKER_NOSAVE_MARK"
    again="asd-dev start $( [[ $SESSION_NAME == default ]] || echo "$SESSION_NAME ")--tmpdisk $2"
    log "[docker] WARNING: $1. Docker started empty; saving is off for this session, so $file is kept."
    queue_notice "asd-dev: $1. Docker started EMPTY, and saving docker state is OFF for this session, so your saved state is kept. To try again with more /tmp: asd-dev stop, then $again"
}

load_docker_state() {
    local file need avail
    file=$(docker_state_file)
    [[ -f $file ]] || {
        log "[docker] no saved docker state for this session yet ($file)"
        return 0
    }
    if ! docker_state_dir_ok || [[ $(stat -c %u "$file") != "$(id -u)" ]]; then
        log "[docker] WARNING: not loading $file: it or its directory is not owned by you, or others can write to it."
        : >"$DOCKER_NOSAVE_MARK"
        return 0
    fi
    # Saves record their unpacked size next to the archive; older ones are checked by the extract.
    need=$(cat "$file.size" 2>/dev/null || true)
    avail=$(df --output=avail -B1 /tmp | tail -n1 | tr -d ' ')
    if [[ $need =~ ^[0-9]+$ && $avail =~ ^[0-9]+$ ]] && ((need + need / 10 > avail)); then
        saving_off "the saved docker state needs $(numfmt --to=iec "$need")B in /tmp, but this session has only $(numfmt --to=iec "$avail")B" \
            $((need * 12 / 10 / 1048576 + 4096))
        return 0
    fi
    log "[docker] loading saved docker state ($(human_size "$file")) from $file ..."
    if zstd -q -d --stdout "$file" | rootlesskit tar --blocking-factor=64 -xpf - -C / tmp/docker; then
        log "[docker] docker state loaded"
    else
        rootlesskit rm -rf /tmp/docker || true
        saving_off "loading the saved docker state failed (see asd-dev logs; it may have run out of /tmp)" \
            $(($(df --output=size -B1M /tmp | tail -n1 | tr -d ' ') * 2))
    fi
}

start_docker() {
    if [[ $DOCKER_STATE == yes ]]; then load_docker_state; fi
    : >"$DOCKER_LOADED_MARK"
    log "[docker] starting rootless dockerd"
    /opt/slurm/bin/slurm-start-dockerd.sh 2>&1 | sed -u 's/^/[docker] /'
}

stop_dockerd() {
    local pid i
    pid=$(cat /tmp/run/docker.pid 2>/dev/null || true)
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null || return 0
    log "[docker] stopping dockerd (pid $pid) so its state is consistent"
    kill -TERM "$pid" 2>/dev/null || true
    for ((i = 0; i < 60; i++)); do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done
    log "[docker] WARNING: dockerd did not exit within 60 s"
}

save_docker_state() {
    local why=$1 file tmp
    [[ $DOCKER_STATE == yes && -d /tmp/docker ]] || return 0
    if [[ ! -e $DOCKER_LOADED_MARK ]]; then
        log "[docker] not saving docker state: it was still being loaded"
        return 0
    fi
    if [[ -e $DOCKER_NOSAVE_MARK ]]; then
        log "[docker] not saving docker state: saving is off for this session (see above), the saved file is kept"
        return 0
    fi
    file=$(docker_state_file)
    if [[ ! -d $DOCKER_STATE_DIR ]]; then
        mkdir -p "$DOCKER_STATE_DIR" && chmod 700 "$DOCKER_STATE_DIR"
    fi
    if ! docker_state_dir_ok; then
        log "[docker] WARNING: not saving docker state: $DOCKER_STATE_DIR is not owned by you or others can write to it"
        return 0
    fi
    log "[docker] saving docker state ($why) to $file ..."
    # Leftovers of a save that SLURM killed; one job per session name writes here.
    rm -f "$file".tmp.* "$file".size.tmp
    tmp=$(mktemp "$file.tmp.XXXXXX")
    SAVE_TMP=$tmp
    # Read the archive back before it replaces the previous one; that also yields the unpacked
    # size, which the next load compares with the free /tmp space.
    local size
    if rootlesskit tar -C / -cf - tmp/docker | zstd -q -T0 -3 >"$tmp" &&
        size=$(zstd -q -d --stdout "$tmp" | wc -c) && ((size > 0)); then
        mv -f "$tmp" "$file"
        SAVE_TMP=""
        (umask 077 && printf '%s\n' "$size" >"$file.size.tmp") && mv -f "$file.size.tmp" "$file.size"
        log "[docker] docker state saved ($(human_size "$file"), $(numfmt --to=iec "$size")B unpacked)"
    else
        rm -f "$tmp"
        SAVE_TMP=""
        log "[docker] WARNING: saving docker state failed; the previous save is kept"
    fi
}

# Environment for ssh sessions: sshd starts them with a clean environment, without the job's.
session_setenv() {
    local vars=(SLURM_JOB_ID SLURM_JOBID SLURM_JOB_NAME SLURM_JOB_NODELIST SLURM_NODELIST SLURM_JOB_PARTITION
        SLURM_CPUS_ON_NODE SLURM_JOB_CPUS_PER_NODE SLURM_MEM_PER_NODE SLURM_JOB_END_TIME SLURM_CLUSTER_NAME
        SLURM_JOB_GPUS SLURM_GPUS_ON_NODE CUDA_VISIBLE_DEVICES GPU_DEVICE_ORDINAL)
    local out="XDG_RUNTIME_DIR=/tmp/run DOCKER_HOST=unix:///tmp/run/docker.sock TMPDIR=/tmp"
    out+=" ASD_DEV_SESSION=$SESSION_NAME"
    [[ $PATH != *[\"\\]* ]] && out+=" PATH=\"$ROOT/bin:$PATH\""
    local v
    for v in "${vars[@]}"; do
        [[ -n ${!v:-} && ${!v} != *[[:space:]\"\\]* ]] && out+=" $v=${!v}"
    done
    printf '%s' "$out"
}

port_in_use() { ss -Hltn "( sport = :$1 )" 2>/dev/null | grep -q .; }

# Starts sshd on the first free candidate port. Sets SSHD_PID and PORT.
start_sshd() {
    local candidates=("$@") p i opts=(
        -h "$HOSTKEY"
        -o PidFile=none
        -o "AuthorizedKeysFile=/etc/cluster/users/%U/.ssh/authorized_keys .ssh/authorized_keys"
        -o AuthenticationMethods=publickey
        -o PasswordAuthentication=no
        -o KbdInteractiveAuthentication=no
        -o UsePAM=no
        -o UseDNS=no
        -o PrintMotd=no
        -o PrintLastLog=no
        -o "Subsystem=sftp internal-sftp"
        -o ClientAliveInterval=30
        -o ClientAliveCountMax=4
        -o AllowTcpForwarding=yes
        -o AllowAgentForwarding=yes
        -o X11Forwarding=no
        -o "SetEnv=$(session_setenv)"
    )
    [[ -n $ADDR ]] && opts+=(-o "ListenAddress=$ADDR")
    for p in "${candidates[@]}"; do
        port_in_use "$p" && continue
        /usr/sbin/sshd -D -e -f /dev/null -p "$p" "${opts[@]}" </dev/null &
        SSHD_PID=$!
        for ((i = 0; i < 50; i++)); do
            sleep 0.1
            kill -0 "$SSHD_PID" 2>/dev/null || break
            if port_in_use "$p"; then
                PORT=$p
                return 0
            fi
        done
        kill "$SSHD_PID" 2>/dev/null || true
        wait "$SSHD_PID" 2>/dev/null || true
        log "port $p did not work; trying another"
    done
    return 1
}

write_state() {
    local tmp
    tmp=$(mktemp "$SESSIONS/.$SLURM_JOB_ID.XXXXXX")
    printf 'job=%s\nname=%s\nnode=%s\naddr=%s\nport=%s\nversion=%s\n' \
        "$SLURM_JOB_ID" "$SESSION_NAME" "$(hostname -s)" "$ADDR" "$PORT" "$ASD_DEV_VERSION" >"$tmp"
    mv -f "$tmp" "$(state_file "$SLURM_JOB_ID")"
}

record_end() { write_end_record "$SESSION_NAME" "$SLURM_JOB_ID" "$1" "$2"; } # record_end REASON KIND

remove_job_files() {
    rm -f "$(state_file "$SLURM_JOB_ID")" "$SESSIONS/$SLURM_JOB_ID".{stop,seen,stopping}
}

finish() { # finish REASON KIND
    local why=$1
    # First, so proxies and "asd-dev start" report "stopping" instead of "starting" meanwhile.
    : >"$SESSIONS/$SLURM_JOB_ID.stopping"
    log "stopping: $why"
    notify_terminals "asd-dev: this session (job $SLURM_JOB_ID) is stopping: $why."
    record_end "$why" "$2"
    rm -f "$(state_file "$SLURM_JOB_ID")"
    kill "$SSHD_PID" 2>/dev/null || true
    if [[ $DOCKER_STATE == yes ]]; then
        stop_dockerd
        save_docker_state "$why"
    fi
    remove_job_files
    log "session ended"
    exit 0
}

on_term() {
    log "SLURM is ending the job (time limit or scancel)"
    notify_terminals "asd-dev: SLURM is ending this session now (time limit reached, or the job was cancelled)."
    record_end "it was ended by SLURM (time limit or cancel)" slurm
    # A save cut short by SLURM leaves a partial archive; the previous save stays in place.
    [[ -n ${SAVE_TMP:-} ]] && rm -f "$SAVE_TMP"
    remove_job_files
    exit 143
}

fail_start() { # fail_start REASON
    log "ERROR: $1"
    record_end "it failed to start: $1" fail
    remove_job_files
    exit 1
}

# Prints the PIDs of this job's processes, comma-separated (from the job's cgroup).
job_pids() {
    local cg pids
    cg=$(sed -n 's/^0:://p' /proc/self/cgroup)
    pids=$(find "/sys/fs/cgroup${cg%%/step_*}" -name cgroup.procs -exec cat {} + 2>/dev/null | tr '\n' ',' || true)
    printf '%s' "${pids%,}"
}

# Prints the terminals (pts/N) of this job's processes: VS Code terminals and ssh sessions.
job_terminals() {
    local pids
    pids=$(job_pids)
    [[ -n $pids ]] || return 0
    ps -o tty= -p "$pids" 2>/dev/null | sort -u | grep '^pts/' || true
}
have_terminal() { [[ -n $(job_terminals) ]]; }

notify_terminals() {
    local tty
    for tty in $(job_terminals); do
        printf '\r\n\033[1;33m%s\033[0m\n' "$1" >"/dev/$tty" 2>/dev/null || true
    done
}

# Warns once when the job's /tmp (docker's data root) is nearly full.
check_tmp_space() {
    local use
    use=$(df -P /tmp 2>/dev/null | awk 'NR == 2 { sub(/%/, "", $5); print $5 }')
    [[ $use =~ ^[0-9]+$ ]] || return 0
    if ((use >= 90)) && [[ $TMP_WARNED != yes ]]; then
        TMP_WARNED=yes
        local msg
        msg="asd-dev: /tmp of this session is ${use}% full ($(df -Ph /tmp | awk 'NR == 2 { print $3 " of " $2 }'));"
        msg+=" docker keeps its images there. Free space with 'docker system prune', or give the next session more:"
        msg+=" asd-dev stop, then asd-dev start --tmpdisk 65536"
        log "$msg"
        notify_terminals "$msg"
    elif ((use < 80)); then
        TMP_WARNED=no
    fi
}

# Something is connected now, connected since the last check (short scp or "ssh host cmd" runs
# touch the .seen file in the proxy), or a tmux/screen keeps work alive.
session_active() {
    local conns seen now
    now=$(date +%s)
    conns=$(ss -Htn state established "( sport = :$PORT )" 2>/dev/null | wc -l)
    seen=$(stat -c %Y "$SESSIONS/$SLURM_JOB_ID.seen" 2>/dev/null || echo 0)
    if ((conns > 0 || seen >= LAST_CHECK)); then
        LAST_CHECK=$now
        return 0
    fi
    LAST_CHECK=$now
    local pids
    pids=$(job_pids)
    [[ -n $pids ]] && ps -o comm= -p "$pids" 2>/dev/null | grep -qE '^(tmux|screen|SCREEN)'
}

cmd_job() {
    [[ -n ${SLURM_JOB_ID:-} ]] || die "'_job' runs inside the SLURM session job; use 'asd-dev start'."
    SESSION_NAME=${1:-default}
    shift || true
    check_name "$SESSION_NAME"
    local idle_timeout=60 kv started_by=start
    DOCKER_STATE=yes
    for kv in "$@"; do
        case $kv in
            idle_timeout=*) idle_timeout=${kv#*=} ;;
            docker_state=*) DOCKER_STATE=${kv#*=} ;;
            started_by=*) started_by=${kv#*=} ;;
        esac
    done
    unset SSH_AUTH_SOCK SSH_CLIENT SSH_CONNECTION SSH_TTY
    DOCKER_STATE_DIR="$DOCKER_STATE_ROOT/$(id -u)"
    SSHD_PID="" PORT=""
    # Traps first: with a short --time, SLURM's USR1 can arrive within seconds of the start.
    SAVE_REQUESTED=no
    trap on_term TERM INT HUP
    trap 'SAVE_REQUESTED=yes' USR1
    mkdir -p "$SESSIONS" "$LOGS"
    # Replaced by the real reason when the session ends; left as is it means SLURM killed it.
    record_end "it is running" running
    log "asd-dev $ASD_DEV_VERSION: session '$SESSION_NAME', job $SLURM_JOB_ID on $(hostname -s)," \
        "${SLURM_CPUS_ON_NODE:-?} CPUs, ${SLURM_MEM_PER_NODE:-?} MB RAM, $(df -Ph /tmp | awk 'NR == 2 { print $2 }') /tmp," \
        "idle_timeout=${idle_timeout} min, docker_state=$DOCKER_STATE"
    [[ -f $HOSTKEY ]] || fail_start "$HOSTKEY is missing; run the setup script on your laptop again"

    ADDR=$(getent ahostsv4 "$(hostname -s).$CLUSTER_DOMAIN" 2>/dev/null | awk 'NR == 1 { print $1 }' || true)
    if [[ -z $ADDR ]]; then
        ADDR=$(ip -4 -o addr show 2>/dev/null | awk '$4 ~ /^10\.0\.50\./ { sub(/\/.*/, "", $4); print $4; exit }' || true)
    fi
    [[ -n $ADDR ]] || log "WARNING: could not find this node's cluster network address; sshd listens on all addresses"
    local candidates=($(($(id -u) * 20 - 1))) i
    for ((i = 0; i < 10; i++)); do candidates+=($((20000 + RANDOM % 12000))); done
    start_sshd "${candidates[@]}" || fail_start "could not start sshd on any port"
    write_state
    log "sshd listening on ${ADDR:-*}:$PORT (pid $SSHD_PID); connect with VS Code to $(host_alias "$SESSION_NAME")"

    # Docker state is saved with dockerd stopped, so the session ends 5 min before its time limit
    # to have the time for that (only for sessions longer than 15 min).
    local end=${SLURM_JOB_END_TIME:-0} begin=${SLURM_JOB_START_TIME:-0} early_end=0
    if [[ $DOCKER_STATE == yes && $end =~ ^[0-9]+$ && $begin =~ ^[0-9]+$ ]] && ((end - begin > 900)); then
        early_end=$((end - 300))
    fi

    start_docker &

    local last_active=$SECONDS tick=0 line
    TMP_WARNED=no LAST_CHECK=$(date +%s)
    while true; do
        sleep 5 &
        wait $! || true
        if [[ -e $SESSIONS/$SLURM_JOB_ID.stop ]]; then
            finish "stopped with 'asd-dev stop'" stop
        fi
        if [[ $SAVE_REQUESTED == yes ]]; then
            SAVE_REQUESTED=no
            log "the time limit is 10 minutes away"
            if ((early_end > 0)); then
                notify_terminals "asd-dev: this session (job $SLURM_JOB_ID) ends at $(date -u -d "@$early_end" '+%H:%M') UTC, 5 minutes before its time limit, to save docker state. Save your work."
            else
                notify_terminals "asd-dev: this session (job $SLURM_JOB_ID) reaches its time limit in 10 minutes and then stops. Save your work."
            fi
        fi
        if ((early_end > 0 && $(date +%s) >= early_end)); then
            finish "it reached its time limit (ended 5 min early to save docker state)" timeout
        fi
        if [[ -s $NOTICE_QUEUE ]] && have_terminal; then
            while IFS= read -r line; do notify_terminals "$line"; done <"$NOTICE_QUEUE"
            : >"$NOTICE_QUEUE"
        fi
        if ! kill -0 "$SSHD_PID" 2>/dev/null; then
            log "WARNING: sshd exited; restarting it on port $PORT"
            start_sshd "$PORT" || finish "sshd could not be restarted" fail
        fi
        tick=$((tick + 1))
        # Tell the user once, in the first terminal that appears, that VS Code booked this job.
        if [[ $started_by == vscode ]] && ((tick % 6 == 0)) && have_terminal; then
            started_by=notified
            notify_terminals "asd-dev: VS Code started this session (job $SLURM_JOB_ID: ${SLURM_CPUS_ON_NODE:-?} CPUs, until $(date -u -d "@${SLURM_JOB_END_TIME:-0}" '+%H:%M') UTC) when it connected. It stops ${idle_timeout} min after the last connection closes; to stop it now: $(stop_cmd "$SESSION_NAME")"
        fi
        if ((tick % 12 == 0)); then
            check_tmp_space
            if session_active; then
                last_active=$SECONDS
            elif ((idle_timeout > 0 && SECONDS - last_active >= idle_timeout * 60)); then
                finish "nothing was connected for $idle_timeout min (idle_timeout)" idle
            fi
        fi
    done
}

# ---------------------------------------------------------------- main

usage() {
    cat >&2 <<EOF
asd-dev $ASD_DEV_VERSION: VS Code dev sessions inside WATcloud SLURM jobs.

Usually you do not need any of this: connecting VS Code to "asd-dev-session" starts a
session when none is running (auto_start), and it stops after idle_timeout minutes with
nothing connected.

  asd-dev start [NAME] [options]   start a session (if needed) and wait until it is ready
  asd-dev stop [NAME] [--now]      stop a session (saves docker state first unless --now)
  asd-dev stop --all | --job ID
  asd-dev status                   list your sessions
  asd-dev logs [NAME] [-f]         show a session's log
  asd-dev config [key=value ...]   show or change your defaults (~/.asd-dev/config)
  asd-dev version

Options for start (one-off; use "asd-dev config" to change defaults):
  --cpus N  --mem 16G  --time 6:00:00  --tmpdisk MiB
  --vram MiB (shared GPU slice)  --gpus N (whole GPUs)  --gpu-type rtx_3090  --no-gpu
  --idle-timeout MIN (0 = never)  --no-docker-state  --partition NAME

NAME lets you run more than one session: "asd-dev start gpu" is reached as
"asd-dev-session-gpu" (type that host name in VS Code's "Connect to Host...").
EOF
}

main() {
    local cmd=${1:-help}
    shift || true
    case $cmd in
        proxy) cmd_proxy "$@" ;;
        start) cmd_start "$@" ;;
        stop) cmd_stop "$@" ;;
        status) cmd_status "$@" ;;
        logs | log) cmd_logs "$@" ;;
        config) cmd_config "$@" ;;
        install) cmd_install "$@" ;;
        _job) cmd_job "$@" ;;
        version | --version) printf '%s\n' "$ASD_DEV_VERSION" ;;
        help | -h | --help) usage ;;
        *) usage; die "unknown command '$cmd'" ;;
    esac
}

main "$@"

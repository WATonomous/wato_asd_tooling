#!/bin/bash
# asd-dev: VS Code dev sessions inside WATcloud SLURM jobs (cluster side).
#
# setup.sh / setup.ps1 install this file as ~/.asd-dev/bin/asd-dev on the cluster. It is
#  - the user CLI on the login node: start, stop, status, logs, config ("asd-dev help");
#  - the session job itself ("asd-dev _job", submitted by start with sbatch);
#  - the ProxyCommand target ("asd-dev proxy ALIAS"): connects VS Code's ssh to the sshd inside
#    a running session. It never starts a job.
#
# Keep this file ASCII-only: setup.ps1 uploads it from Windows.
set -o errexit -o nounset -o pipefail

ASD_DEV_VERSION=2.2.0-rc.5
# Bumped on every change; install refuses to replace a newer helper with an older one.
ASD_DEV_SERIAL=26

# The install dir is ~/.asd-dev unless setup was given --cluster-dir (e.g. two installs side by side).
# Inside the job $0 is SLURM's copy of this script, so the job gets ASD_DEV_ROOT from sbatch.
if [[ -n ${ASD_DEV_ROOT:-} ]]; then
    ROOT=$ASD_DEV_ROOT
else
    case $0 in
        */bin/asd-dev | */tmp/asd-dev.new) ROOT=$(cd "$(dirname "$0")/.." && pwd) ;;
        *) ROOT="$HOME/.asd-dev" ;;
    esac
fi
CONFIG="${ASD_DEV_CONFIG:-$ROOT/config}" # override for tests
SESSIONS="$ROOT/sessions"
LOGS="$ROOT/logs"
HOSTKEY="$ROOT/ssh_host_ed25519_key"
# Jobs carry the install in their comment, so two installs never see each other's sessions.
INSTALL_ID=$(basename "$ROOT")
JOB_COMMENT="asd-dev:$INSTALL_ID"
JOB_PREFIX=asd-dev
DOCKER_STATE_ROOT=${ASD_DEV_STATE_ROOT:-/mnt/wato-drive/slurm-docker-sessions} # override for tests
CLUSTER_DOMAIN=cluster.watonomous.ca

export PATH="/opt/slurm/bin:$PATH"

# Session settings are sbatch's own options (by long name), plus asd-dev's --docker-state.
OPT_KEYS=(cpus-per-task mem time partition gres gpus nodelist exclude docker-state)
declare -A DEFAULTS=([cpus-per-task]=4 [mem]=16G [time]=6:00:00 [docker-state]=yes)
# The job's /tmp (docker's data root) is the tmpdisk GRES; a --gres without it gets this many MiB.
TMPDISK_DEFAULT=10240
declare -A CFG=() FILE_SET=()
SESSION_OPTIONS="--cpus-per-task/-c N  --mem 16G  --time/-t 6:00:00  --gres tmpdisk:MiB,shard:MiB  --gpus/-G N
  --partition/-p NAME  --nodelist/-w NODES  --exclude/-x NODES  --docker-state yes|no"
OPTIONS_LINE="Session options (sbatch's): -c/--cpus-per-task, --mem, -t/--time, --gres, -G/--gpus, -p/--partition, -w/--nodelist, -x/--exclude; and --docker-state yes|no"
SETTING_EXAMPLES="Examples: --cpus-per-task 8 --mem 32G --time 4:00:00 --gres tmpdisk:40960,shard:8192 --gpus 1 --docker-state no"
# Settings of earlier versions (key=value lines): upgrade_config drops these and converts the others.
RETIRED_KEYS=" auto_start auto_start_cooldown idle_timeout connect_wait "

# ---------------------------------------------------------------- output helpers

# Where the user reads our messages, so every command hint works there as printed: the laptop
# wrappers pass --from=unix|windows; a session terminal has asd-dev on PATH; on a login node it
# is not.
FROM=""
PARSING_CONFIG=no # "config set" has no session names, so a bare word gets no --name hint
# shellcheck disable=SC2088 # printed for the user to type
hint() { # hint "ARGS": the asd-dev command line for the reader
    case $FROM in
        laptop) laptop_hint "$1" ;;
        unix) printf './asd-dev %s' "$1" ;;
        windows) printf '.\\asd-dev.cmd %s' "$1" ;;
        *) if [[ -n ${ASD_DEV_SESSION:-} ]]; then printf 'asd-dev %s' "$1"; else printf '~/%s/bin/asd-dev %s' "$INSTALL_ID" "$1"; fi ;;
    esac
}
# For text read on the laptop without knowing its OS (VS Code's log, job notices about restarting).
laptop_hint() { printf './asd-dev %s (Windows: .\\asd-dev.cmd %s) in your wato_asd_tooling folder' "$1" "$1"; }
# For job notices in a session's terminal: how to start this session again, with extra options.
restart_hint() { printf 'asd-dev stop here, then on your laptop: %s' "$(laptop_hint "$(with_name start "$SESSION_NAME")${1:+ $1}")"; }

# All human-readable output goes to stderr: in "proxy" mode stdout is the ssh byte stream.
say() { printf 'asd-dev: %s\n' "$*" >&2; }
die() {
    printf 'asd-dev: ERROR: %s\n' "$1" >&2
    shift
    local line
    for line in "$@"; do printf '         %s\n' "$line" >&2; done
    exit 1
}

# ---------------------------------------------------------------- config

# Prints the long name of session option $1 (-c, --cpus-per-task, ...); returns 1 for others.
option_key() {
    case $1 in
        -c) printf 'cpus-per-task' ;;
        -t) printf 'time' ;;
        -p) printf 'partition' ;;
        -G) printf 'gpus' ;;
        -w) printf 'nodelist' ;;
        -x) printf 'exclude' ;;
        --?*) [[ " ${OPT_KEYS[*]} " == *" ${1#--} "* ]] && printf '%s' "${1#--}" ;;
        *) return 1 ;;
    esac
}

valid_value() { # valid_value KEY VALUE
    local items item
    case $1 in
        cpus-per-task) [[ $2 =~ ^[1-9][0-9]*$ ]] ;;
        mem) [[ $2 =~ ^[1-9][0-9]*[KMGT]?$ ]] ;;
        time) [[ $2 =~ ^([0-9]+-)?[0-9]+(:[0-9]{1,2}){0,2}$ ]] ;;
        partition | nodelist | exclude) [[ $2 =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]] ;;
        gpus) [[ $2 =~ ^([A-Za-z0-9_-]+:)?[1-9][0-9]*$ ]] ;;
        gres)
            [[ -n $2 && $2 != ,* && $2 != *, && $2 != *,,* ]] || return 1
            IFS=, read -ra items <<<"$2"
            for item in "${items[@]}"; do
                [[ $item =~ ^[a-z][a-z0-9_]*(:[A-Za-z0-9_-]+)?(:[0-9]+[KMG]?)?$ ]] || return 1
            done
            ;;
        docker-state) [[ $2 == yes || $2 == no ]] ;;
        *) return 1 ;;
    esac
}

# Prints --gres value $2 with the tmpdisk item of $1 added when $2 names no tmpdisk.
gres_keeping_tmpdisk() {
    local items item
    if [[ ,$2, == *,tmpdisk,* || ,$2, == *,tmpdisk:* ]]; then printf '%s' "$2"; return; fi
    IFS=, read -ra items <<<"$1"
    for item in ${items[@]+"${items[@]}"}; do
        if [[ $item == tmpdisk || $item == tmpdisk:* ]]; then printf '%s,%s' "$item" "$2"; return; fi
    done
    printf '%s' "$2"
}

# Applies "key=value" words (key = long option name) to CFG. $1 is a label for error messages.
# A --gres from the command line replaces the saved one but keeps its tmpdisk (/tmp) unless it
# names one, so "start --gres shard:8192" does not shrink a saved tmpdisk:40960.
apply_settings() {
    local origin=$1 kv key value
    shift
    for kv in "$@"; do
        key=${kv%%=*}
        value=${kv#*=}
        valid_value "$key" "$value" || die "$origin: invalid value for --$key: '$value'" "$SETTING_EXAMPLES"
        if [[ $key == gres && $origin == "command line" ]]; then value=$(gres_keeping_tmpdisk "${CFG[gres]}" "$value"); fi
        CFG[$key]=$value
    done
}

# Puts the built-in defaults and then the config file's options into CFG, and the file's own
# options into FILE_SET.
load_config() {
    local line key k
    CFG=() FILE_SET=()
    for k in "${OPT_KEYS[@]}"; do CFG[$k]=${DEFAULTS[$k]:-}; done
    [[ -f $CONFIG ]] || return 0
    # shellcheck disable=SC2094 # $CONFIG is only a label in apply_settings' messages
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        line=${line//[[:space:]]/}
        [[ -n $line ]] || continue
        if [[ $line != --*=* ]] || ! key=$(option_key "${line%%=*}"); then
            die "$CONFIG: cannot read '$line'." "Each line is one option, such as --mem=32G. Change them with: $(hint "config set --mem 32G")"
        fi
        apply_settings "$CONFIG" "$key=${line#*=}"
        FILE_SET[$key]=${line#*=}
    done <"$CONFIG"
}

config_header() {
    cat <<'EOF'
# asd-dev defaults for new sessions: sbatch options, one per line (--option=value). Change them
# from your laptop with  ./asd-dev config set --mem 32G --gres tmpdisk:40960,shard:8192  (Windows:
# .\asd-dev.cmd config set ...; in a session's terminal: asd-dev config set ...) or edit this
# file; "config unset mem" removes a line. Without a line: --cpus-per-task=4 --mem=16G --time=6:00:00
# --docker-state=yes, and --gres always includes tmpdisk:10240 (the job's /tmp) unless it names tmpdisk.
EOF
}

create_default_config() { config_header >"$CONFIG"; }

# Writes FILE_SET to the config file.
write_config() {
    local tmp k
    tmp=$(mktemp "$CONFIG.XXXXXX")
    {
        config_header
        for k in "${OPT_KEYS[@]}"; do
            if [[ -v FILE_SET[$k] ]]; then printf -- '--%s=%s\n' "$k" "${FILE_SET[$k]}"; fi
        done
    } >"$tmp"
    mv -f "$tmp" "$CONFIG"
}

# Converts a config of an earlier version (key=value lines) to sbatch options, keeping its values;
# retired settings are dropped. The old file stays as config.old.
upgrade_config() {
    grep -qE '^[[:space:]]*[a-z_]+[[:space:]]*=' "$CONFIG" || return 0
    local line gpu="" gres="" type
    local -A old=()
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        line=${line//[[:space:]]/}
        if [[ $line =~ ^([a-z_]+)=(.*)$ ]]; then old[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}; fi
    done <"$CONFIG"
    FILE_SET=()
    if [[ -n ${old[cpus]:-} ]]; then FILE_SET[cpus-per-task]=${old[cpus]}; fi
    if [[ -n ${old[mem]:-} ]]; then FILE_SET[mem]=${old[mem]}; fi
    if [[ -n ${old[time]:-} ]]; then FILE_SET[time]=${old[time]}; fi
    if [[ -n ${old[partition]:-} ]]; then FILE_SET[partition]=${old[partition]}; fi
    if [[ -n ${old[docker_state]:-} ]]; then FILE_SET[docker-state]=${old[docker_state]}; fi
    # Old meaning: gpus = whole GPUs (wins over vram), vram = MiB of a GPU slice, gpu_type for either.
    type=${old[gpu_type]:+${old[gpu_type]}:}
    if [[ ${old[gpus]:-0} =~ ^[1-9][0-9]*$ ]]; then
        gpu="gpu:$type${old[gpus]}"
    elif [[ ${old[vram]:-0} =~ ^[1-9][0-9]*$ ]]; then
        gpu="shard:$type${old[vram]}"
    fi
    gres=${old[tmpdisk]:+tmpdisk:${old[tmpdisk]}}
    if [[ -n $gpu ]]; then gres+=${gres:+,}$gpu; fi
    if [[ -n $gres ]]; then FILE_SET[gres]=$gres; fi
    cp "$CONFIG" "$CONFIG.old"
    write_config
    say "converted your session defaults to sbatch options (the old file is $CONFIG.old)."
}

# The --gres a session gets: CFG's, with the default tmpdisk added when it names none.
effective_gres() {
    if [[ ,${CFG[gres]}, == *,tmpdisk,* || ,${CFG[gres]}, == *,tmpdisk:* ]]; then
        printf '%s' "${CFG[gres]}"
    else
        printf 'tmpdisk:%s%s' "$TMPDISK_DEFAULT" "${CFG[gres]:+,${CFG[gres]}}"
    fi
}

# The session settings as sbatch options, joined by $1 (default: a space).
sbatch_options() {
    local k v out=()
    for k in "${OPT_KEYS[@]}"; do
        v=${CFG[$k]}
        [[ $k == gres ]] && v=$(effective_gres)
        if [[ -n $v ]]; then out+=("--$k=$v"); fi
    done
    local IFS=${1:- }
    printf '%s' "${out[*]}"
}
describe_resources() { sbatch_options " "; }

# How an option of an earlier version is written now: old_option_hint KEY VALUE.
old_option_hint() {
    case $1 in
        cpus) printf -- '--cpus-per-task %s' "$2" ;;
        tmpdisk) printf -- '--gres tmpdisk:%s' "$2" ;;
        vram) printf -- '--gres shard:%s (a GPU slice of that many MiB)' "$2" ;;
        gpu-type | gpu_type) printf -- '--gres gpu:%s:1 (a whole GPU) or --gres shard:%s:MiB (a slice)' "$2" "$2" ;;
        no-gpu) printf 'no GPU option (config unset gres gpus clears saved ones)' ;;
        no-docker-state) printf -- '--docker-state no' ;;
        docker_state) printf -- '--docker-state %s' "$2" ;;
        mem | time | partition | gpus) printf -- '--%s %s' "$1" "$2" ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------- session naming

# Host alias -> session name: asd-dev-session -> default, asd-dev-session-<name> -> <name>.
session_from_alias() {
    case $1 in
        asd-dev-session) printf 'default' ;;
        asd-dev-session-?*) printf '%s' "${1#asd-dev-session-}" ;;
        *) die "unknown host '$1'; expected asd-dev-session or asd-dev-session-NAME" ;;
    esac
}

check_name() {
    [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,19}$ ]] ||
        die "invalid session name '$1'" "Use up to 20 lowercase letters, digits, '-' or '_'."
}

with_name() { if [[ $2 == default ]]; then printf '%s' "$1"; else printf '%s --name %s' "$1" "$2"; fi; }
job_name() { if [[ $1 == default ]]; then printf '%s' "$JOB_PREFIX"; else printf '%s' "$JOB_PREFIX-$1"; fi; }
host_alias() { if [[ $1 == default ]]; then printf 'asd-dev-session'; else printf 'asd-dev-session-%s' "$1"; fi; }
name_from_job_name() { if [[ $1 == "$JOB_PREFIX" ]]; then printf 'default'; else printf '%s' "${1#"$JOB_PREFIX"-}"; fi; }

# ---------------------------------------------------------------- SLURM queries

SQ_FORMAT='%i|%T|%N|%r|%k|%L|%S|%j'

# Keeps the SQ_FORMAT lines (stdin) of this install's active jobs.
own_jobs_filter() {
    awk -F'|' -v mine="$JOB_COMMENT" 'NF >= 8 && $5 == mine && $2 != "COMPLETING" && $2 != "COMPLETED"'
}

# Prints this install's active jobs for session $1, oldest first, as SQ_FORMAT lines.
session_jobs() {
    local out
    if ! out=$(squeue --me -h --name="$(job_name "$1")" --sort=i -o "$SQ_FORMAT" 2>&1 </dev/null); then
        die "could not ask SLURM for your jobs (squeue failed):" "$out" \
            "The SLURM controller may be down; check https://status.watonomous.ca"
    fi
    printf '%s\n' "$out" | own_jobs_filter
}

# Prints all of this install's active session jobs (with CPUs, memory and GRES appended).
all_session_jobs() {
    squeue --me -h --sort=i -o "$SQ_FORMAT|%C|%m|%b" </dev/null |
        awk -F'|' -v p="$JOB_PREFIX" '$8 == p || index($8, p "-") == 1' | own_jobs_filter
}

# Sets J_* globals from a line that starts with the SQ_FORMAT fields.
parse_job() {
    IFS='|' read -r J_ID J_STATE J_NODE J_REASON _ J_LEFT J_START J_NAME _ <<<"$1"
}

# Puts session $1's oldest job into J_* and the ids of any newer ones into J_OTHERS; returns 1
# if there is none.
find_session_job() {
    local jobs
    jobs=$(session_jobs "$1") || exit 1
    [[ -n $jobs ]] || return 1
    J_OTHERS=$(printf '%s\n' "$jobs" | tail -n +2 | cut -d'|' -f1 | paste -sd' ' -)
    parse_job "$(printf '%s\n' "$jobs" | head -n1)"
}

# Removes per-job files of jobs that are no longer active (left behind by hard kills).
cleanup_stale() {
    local jobs active f id
    # Without an answer from SLURM nothing is known to be stale.
    jobs=$(timeout 15 squeue --me -h -o "$SQ_FORMAT" 2>/dev/null </dev/null) || return 0
    active=" $(printf '%s\n' "$jobs" | own_jobs_filter | cut -d'|' -f1 | paste -sd' ' -) "
    for f in "$SESSIONS"/*.env "$SESSIONS"/*.stop "$SESSIONS"/*.stopping; do
        [[ -e $f ]] || continue
        id=${f##*/}
        id=${id%%.*}
        [[ $id =~ ^[0-9]+$ && $active != *" $id "* ]] && rm -f "$f"
    done
    return 0
}

refresh_job() {
    local line
    if line=$(squeue -h -j "$J_ID" -o "$SQ_FORMAT" 2>&1 </dev/null); then
        if [[ -n $line ]]; then parse_job "$line"; else J_STATE=GONE; fi
    elif [[ $line == *"Invalid job id"* ]]; then
        J_STATE=GONE
    fi
    # Any other squeue failure (controller hiccup): keep the last known state and retry.
}

# Explains a SLURM pending reason in plain words. Returns 1 when the job cannot start as requested.
explain_reason() {
    case $1 in
        None | "") echo "waiting for the scheduler" ;;
        Resources) echo "waiting for free resources: the cluster is busy, it starts when enough is free" ;;
        Priority) echo "waiting in the queue: other jobs are ahead of yours" ;;
        QOSMax* | AssocMax* | AssocGrp* | QOSGrp* | MaxCpuPerAccount | MaxGRESPerAccount | MaxMemPerLimit)
            echo "held back by your per-user limit ($1): your other jobs already use your share; stop some (squeue --me) or ask for less"
            ;;
        ReqNodeNotAvail* | PartitionDown | NodeDown) echo "waiting for nodes that fit this request, which are unavailable right now ($1)" ;;
        PartitionTimeLimit) echo "the time limit is longer than the partition allows ($1)"; return 1 ;;
        BadConstraints | PartitionConfig | InvalidQOS | InvalidAccount | QOSJobLimit) echo "SLURM cannot run this request ($1)"; return 1 ;;
        JobHeld* | launch_failed_requeued_held) echo "held by SLURM ($1)"; return 1 ;;
        *) echo "pending ($1)" ;;
    esac
}

# ---------------------------------------------------------------- session state files

state_file() { printf '%s/%s.env' "$SESSIONS" "$1"; }
# True once whoever ran this command is gone: a closed laptop ssh sends no signal without a pty.
client_gone() { [[ $(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ') != "$PPID" ]]; }
is_stopping() { [[ -e $SESSIONS/$1.stopping || -e $SESSIONS/$1.stop ]]; }

# Reads the session state written by the job into S_* globals; returns 1 if missing.
read_state() {
    local f key value
    f=$(state_file "$1")
    S_NODE="" S_ADDR="" S_PORT=""
    [[ -f $f ]] || return 1
    while IFS='=' read -r key value; do
        case $key in
            node) S_NODE=$value ;;
            addr) S_ADDR=$value ;;
            port) S_PORT=$value ;;
        esac
    done <"$f"
    [[ -n $S_PORT && -n $S_NODE ]]
}

# ---------------------------------------------------------------- commands: proxy, start

# Waits until session job J_ID accepts ssh connections, printing progress. Returns 1 at the
# deadline ($1, in $SECONDS; 0 = none) and dies when the job cannot or will not become ready.
wait_ready() {
    local deadline=$1 msg last_msg="" why running_since=""
    while true; do
        if client_gone; then exit 130; fi
        refresh_job
        case $J_STATE in
            PENDING | CONFIGURING | REQUEUED | RESIZING)
                if [[ $J_STATE == CONFIGURING ]]; then
                    msg="job $J_ID is being set up on $J_NODE"
                elif why=$(explain_reason "$J_REASON"); then
                    msg="job $J_ID is $why"
                    [[ $J_START != N/A && -n $J_START ]] && msg+=" (SLURM's estimated start: $J_START UTC)"
                else
                    die "job $J_ID cannot start: $why" "Stop it with: $(hint "stop --job $J_ID")"
                fi
                ;;
            RUNNING)
                running_since=${running_since:-$SECONDS}
                if is_stopping "$J_ID"; then
                    die "job $J_ID is stopping (saving docker state first if that is on)." \
                        "Start it again once $(hint status) no longer lists it."
                fi
                # The job writes its state file only once sshd listens, so no probe is needed.
                read_state "$J_ID" && return 0
                msg="job $J_ID is starting on $J_NODE"
                if ((SECONDS - running_since > 90)); then
                    die "$msg after 90 seconds; the session did not come up." \
                        "Its log: $(hint "logs --job $J_ID"). Then stop it with: $(hint "stop --job $J_ID")"
                fi
                ;;
            GONE | COMPLETED | CANCELLED | FAILED | TIMEOUT | NODE_FAIL | PREEMPTED | OUT_OF_MEMORY | BOOT_FAIL | DEADLINE)
                die "job $J_ID ended before it was ready ($J_STATE)." "Its log: $(hint "logs --job $J_ID")"
                ;;
            *) msg="job $J_ID is $J_STATE" ;;
        esac
        if [[ $msg != "$last_msg" ]]; then
            say "$msg"
            last_msg=$msg
        fi
        if ((deadline > 0 && SECONDS >= deadline)); then return 1; fi
        sleep 1
    done
}

# ProxyCommand target: connects to a running session; it never starts one.
cmd_proxy() {
    local name
    # What this prints lands in VS Code's log on the laptop.
    FROM=laptop
    name=$(session_from_alias "${1:-asd-dev-session}")
    check_name "$name"
    if ! find_session_job "$name"; then
        # The first line must stand alone: VS Code shows only its log, and users skim it.
        die "no session '$name' is running. Start one on your laptop: $(laptop_hint "$(with_name start "$name")")"
    fi
    [[ -z $J_OTHERS ]] || say "WARNING: session '$name' has more than one job; using the oldest ($J_ID)." \
        "Stop the others ($J_OTHERS) with: $(hint "stop --job ID")"
    if [[ $J_STATE == PENDING ]]; then
        die "session '$name' (job $J_ID) is still waiting to start: $(explain_reason "$J_REASON" || true)." \
            "Connect once it runs; $(laptop_hint status) shows when."
    fi
    # A session that has just started may need a few seconds until its sshd listens.
    wait_ready $((SECONDS + 10)) ||
        die "session '$name' (job $J_ID) is not ready yet; try again in a few seconds."
    local addr=${S_ADDR:-$S_NODE.$CLUSTER_DOMAIN} started=$SECONDS rc=0
    nc -N "$addr" "$S_PORT" || rc=$?
    # A quick failure means nothing answered; a late one is just the end of a connection.
    if ((rc != 0 && SECONDS - started < 5)); then
        die "could not reach the session's ssh server ($addr port $S_PORT on $S_NODE, job $J_ID)." \
            "It restarts by itself if it crashed; retry in a few seconds. Its log: $(laptop_hint "$(with_name logs "$name")")"
    fi
    exit "$rc"
}

# Parses the arguments of start/stop/status/logs/config set into NAME, FLAG_* and FLAG_SETTINGS
# ("key=value", key = sbatch's long option name).
parse_session_flags() {
    # Inside a session, "asd-dev stop" means this session (sshd's SetEnv provides ASD_DEV_SESSION).
    NAME=${ASD_DEV_SESSION:-default} NAME_GIVEN=no FLAG_SETTINGS=() FLAG_NOW=no FLAG_JOB=""
    FLAG_ALL=no FLAG_FOLLOW=no RESET_DOCKER_STATE=no
    local word opt value key hint_text
    while (($#)); do
        word=$1 opt=$1 value=""
        if [[ $word == --*=* ]]; then opt=${word%%=*} value=${word#*=}; fi
        key=$(option_key "$opt") || key=""
        if [[ -n $key || $opt == --name || $opt == --job ]] && [[ $word != *=* ]]; then
            (($# >= 2)) || die "$opt needs a value"
            value=$2
            shift
        fi
        if [[ -n $key ]]; then
            FLAG_SETTINGS+=("$key=$value")
            shift
            continue
        fi
        case $opt in
            --name) NAME=${value,,} NAME_GIVEN=yes ;;
            --job) FLAG_JOB=$value ;;
            --reset-docker-state) RESET_DOCKER_STATE=yes ;;
            --now) FLAG_NOW=yes ;;
            --all) FLAG_ALL=yes ;;
            -f | --follow) FLAG_FOLLOW=yes ;;
            -h | --help) usage; exit 0 ;;
            --cpus | --tmpdisk | --vram | --gpu-type | --no-gpu | --no-docker-state)
                die "$opt is gone: asd-dev now takes sbatch's own options. Use $(old_option_hint "${opt#--}" "${value:-${2:-N}}")." ;;
            -o | --output | -e | --error | -J | --job-name | --comment | --wrap | -a | --array | -D | --chdir | \
                --export | --signal | --parsable | -W | --wait | -n | --ntasks | -N | --nodes)
                die "$opt cannot be used: the session job sets it itself, or it would break the session." \
                    "$OPTIONS_LINE" ;;
            -*) die "unknown option '$opt'" "$OPTIONS_LINE" ;;
            *=*)
                key=${word%%=*}
                if [[ $RETIRED_KEYS == *" $key "* ]]; then
                    die "'$key' is no longer used: sessions start only with start and end at their time limit or with stop."
                fi
                hint_text=$(old_option_hint "$key" "${word#*=}") ||
                    die "unexpected argument '$word'" "$OPTIONS_LINE"
                die "'$word' is the old form: asd-dev now takes sbatch's own options. Use $hint_text."
                ;;
            *)
                if [[ $word =~ ^[a-z][a-z0-9_]*:[A-Za-z0-9_:-]+$ ]]; then
                    die "unexpected argument '$word'." "If it belongs to --gres, join the items with commas: --gres tmpdisk:40960,shard:8192"
                fi
                [[ $PARSING_CONFIG == no ]] || die "unexpected argument '$word'" "$OPTIONS_LINE"
                die "unexpected argument '$word'; to name a session use --name $word"
                ;;
        esac
        shift
    done
    check_name "$NAME"
}

refuse_existing() { # dies for the session job in J_*
    if [[ $J_STATE == RUNNING ]] && is_stopping "$J_ID"; then
        die "session '$NAME' (job $J_ID) is stopping (saving docker state first if that is on)." \
            "Start it again once $(hint status) no longer lists it."
    fi
    local connect=()
    [[ $J_STATE == RUNNING ]] && connect=("Connect: VS Code > Remote Explorer > SSH > $(host_alias "$NAME")   (terminal: ssh $(host_alias "$NAME"))")
    die "session '$NAME' already exists (job $J_ID, $J_STATE${J_NODE:+ on $J_NODE})." ${connect[@]+"${connect[@]}"} \
        "To restart it with other settings: $(hint "$(with_name stop "$NAME")"), then start it."
}

cmd_start() {
    parse_session_flags "$@"
    load_config
    if ((${#FLAG_SETTINGS[@]})); then apply_settings "command line" "${FLAG_SETTINGS[@]}"; fi
    if find_session_job "$NAME"; then refuse_existing; fi
    mkdir -p "$LOGS" "$SESSIONS"
    [[ -f $HOSTKEY ]] || die "the session host key $HOSTKEY is missing." "Run the setup script on your laptop again."
    # shellcheck disable=SC2054 # the comma belongs to --export's value
    local out args=(
        --parsable
        --job-name="$(job_name "$NAME")"
        --comment="$JOB_COMMENT"
        --chdir="$HOME"
        --output="$LOGS/%j.log"
        --gres="$(effective_gres)"
        --signal=B:USR1@600
        --export=ALL,ASD_DEV_ROOT="$ROOT"
    )
    local k
    for k in cpus-per-task mem time partition gpus nodelist exclude; do
        if [[ -n ${CFG[$k]} ]]; then args+=("--$k=${CFG[$k]}"); fi
    done
    # --export=ALL would carry GPU and SLURM variables of a session this runs in into the new job.
    local v unset=()
    for v in $(compgen -v SLURM_) CUDA_VISIBLE_DEVICES GPU_DEVICE_ORDINAL ROCR_VISIBLE_DEVICES ASD_DEV_SESSION; do
        [[ $v == SLURM_CONF ]] || unset+=(-u "$v")
    done
    if ! out=$(env "${unset[@]}" sbatch "${args[@]}" "$ROOT/bin/asd-dev" _job "$NAME" \
        "docker_state=${CFG[docker-state]}" "reset_docker_state=$RESET_DOCKER_STATE" "gres=$(effective_gres)" 2>&1 </dev/null); then
        die "SLURM rejected the session job:" "$out" "Requested: $(describe_resources)"
    fi
    local new
    new=$(printf '%s\n' "$out" | grep -Eo '^[0-9]+' | tail -n1)
    [[ -n $new ]] || die "could not read the job id from sbatch output:" "$out"
    # Two starts at once both pass the check above; the newer job gives way.
    if find_session_job "$NAME" && [[ $J_ID != "$new" ]]; then
        scancel "$new" </dev/null || true
        say "another start of '$NAME' got there first; cancelled the new job $new."
        refuse_existing
    fi
    J_ID=$new
    say "submitted job $J_ID: $(describe_resources)"
    trap 'say "stopped waiting; job $J_ID keeps going. Check it with: $(hint status)   cancel it with: $(hint "$(with_name stop "$NAME")")"; exit 130' INT HUP TERM
    wait_ready 0
    trap - INT HUP TERM
    refresh_job
    # Only the laptop wrappers read the READY line, and only there does "ssh <alias>" work.
    local laptop=no term
    [[ $FROM == unix || $FROM == windows ]] && laptop=yes
    term="terminal: ssh $(host_alias "$NAME")"
    [[ $laptop == yes ]] || term="from your laptop: ssh $(host_alias "$NAME")"
    say "ready: connect VS Code to $(host_alias "$NAME") (job $J_ID on $J_NODE, $J_LEFT left; $term)."
    say "It ends at its time limit or with: $(hint "$(with_name stop "$NAME")")"
    if [[ $NAME != default && -n ${SLURM_JOB_ID:-} ]]; then
        say "VS Code lists $(host_alias "$NAME") once your laptop has its entry: $(laptop_hint "add --name $NAME")."
    fi
    if [[ $laptop == yes ]]; then printf 'ASD_DEV_READY %s %s\n' "$(host_alias "$NAME")" "$J_ID"; fi
}

# ---------------------------------------------------------------- commands: stop, status, logs, config

# Waits until job $1 has left the queue; returns 1 after 15 minutes.
wait_job_gone() {
    local waited=0
    while squeue -h -j "$1" -t PD,CF,R,CG,S -o %T 2>/dev/null </dev/null | grep -q .; do
        sleep 3
        waited=$((waited + 3))
        if ((waited % 60 == 0)); then say "still stopping ($waited s)..."; fi
        if ((waited >= 900)); then return 1; fi
    done
}

stop_job() { # stop_job ID STATE NODE
    local id=$1 state=$2 node=$3
    if [[ $state != RUNNING || $FLAG_NOW == yes ]]; then
        scancel "$id" </dev/null
        say "cancelled job $id."
        return
    fi
    mkdir -p "$SESSIONS"
    : >"$SESSIONS/$id.stop"
    if [[ ${SLURM_JOB_ID:-} == "$id" ]]; then
        say "stopping this session (job $id). It saves docker state if that is on, then this window disconnects."
        return
    fi
    say "stopping job $id on $node (saving docker state first if that is on; this can take a few minutes)..."
    if ! wait_job_gone "$id"; then
        say "job $id did not stop within 15 minutes; cancelling it."
        scancel "$id" </dev/null
        return
    fi
    say "job $id stopped."
}

cmd_stop() {
    parse_session_flags "$@"
    local lines line
    if [[ -n $FLAG_JOB ]]; then
        line=$(squeue --me -h -j "$FLAG_JOB" -o "$SQ_FORMAT" 2>/dev/null </dev/null | own_jobs_filter || true)
        [[ -n $line ]] || die "job $FLAG_JOB is not an active session of this install ($ROOT)." \
            "For other jobs use: scancel $FLAG_JOB"
        parse_job "$line"
        stop_job "$J_ID" "$J_STATE" "$J_NODE"
        return
    fi
    if [[ $FLAG_ALL == yes ]]; then lines=$(all_session_jobs); else lines=$(session_jobs "$NAME"); fi
    if [[ -z $lines ]]; then
        if [[ $FLAG_ALL == yes ]]; then say "no session is running."; else say "no '$NAME' session is running."; fi
        return 0
    fi
    while IFS= read -r line; do
        parse_job "$line"
        stop_job "$J_ID" "$J_STATE" "$J_NODE"
    done <<<"$lines"
}

cmd_status() {
    parse_session_flags "$@"
    local lines line cpus mem gres name seen=" "
    cleanup_stale
    lines=$(all_session_jobs)
    if [[ $NAME_GIVEN == yes ]]; then lines=$(printf '%s\n' "$lines" | awk -F'|' -v j="$(job_name "$NAME")" '$8 == j'); fi
    if [[ -z $lines ]]; then
        if [[ $NAME_GIVEN == yes ]]; then
            say "no '$NAME' session is running. Start it: $(hint "$(with_name start "$NAME")")"
        else
            say "no session is running. Start one: $(hint start)"
        fi
        return 0
    fi
    printf '%-10s %-8s %-10s %-14s %-12s %s\n' SESSION JOB STATE NODE TIME_LEFT RESOURCES >&2
    while IFS= read -r line; do
        parse_job "$line"
        IFS='|' read -r cpus mem gres <<<"$(printf '%s' "$line" | cut -d'|' -f9-11)"
        [[ $J_STATE == RUNNING ]] && is_stopping "$J_ID" && J_STATE=STOPPING
        name=$(name_from_job_name "$J_NAME")
        printf '%-10s %-8s %-10s %-14s %-12s --cpus-per-task=%s --mem=%s --gres=%s\n' "$name" "$J_ID" \
            "$J_STATE" "${J_NODE:-"-"}" "$J_LEFT" "$cpus" "$mem" "${gres//gres\//}" >&2
        if [[ $J_STATE == PENDING ]]; then say "  job $J_ID is $(explain_reason "$J_REASON" || true)"; fi
        if [[ $seen == *" $name "* ]]; then
            say "  WARNING: job $J_ID is a second '$name' session, which connections do not use; stop it with: $(hint "stop --job $J_ID")"
        fi
        seen+="$name "
    done <<<"$lines"
    say "Connect: VS Code > Remote Explorer > SSH > asd-dev-session[-NAME]. Stop: $(hint "stop [--name NAME]")"
}

# Prints the job id of session $1's newest log; each log's first line names its session.
newest_log() {
    local f
    # shellcheck disable=SC2012 # our own file names, newest first
    ls -t "$LOGS" 2>/dev/null | while IFS= read -r f; do
        if head -n 3 "$LOGS/$f" | grep -qF "session '$1', job"; then
            printf '%s' "${f%.log}"
            break
        fi
    done || true
}

cmd_logs() {
    parse_session_flags "$@"
    local id=$FLAG_JOB
    if [[ -z $id ]]; then
        if find_session_job "$NAME"; then
            id=$J_ID
        else
            id=$(newest_log "$NAME")
        fi
    fi
    [[ -n $id && -f $LOGS/$id.log ]] || die "no log found${id:+ for job $id}."
    say "log of job $id: $LOGS/$id.log"
    if [[ $FLAG_FOLLOW == yes ]]; then tail -n 50 -f --pid="$PPID" "$LOGS/$id.log"; else tail -n 50 "$LOGS/$id.log"; fi
}

# config: show the defaults; config set OPTIONS: save options; config unset OPTION...: remove them.
cmd_config() {
    local sub=${1:-} word k kv
    shift || true
    case $sub in
        "" | set | unset) ;;
        -h | --help) usage; exit 0 ;;
        --name | --name=*) die "config sets the defaults of every session; it takes no --name." ;;
        --unset) die "to remove a default use: $(hint "config unset ${1:-OPTION}")" ;;
        -*) die "to change your defaults use: $(hint "config set $sub${*:+ $*}")" ;;
        *) die "unknown config command '$sub'." "Show your defaults: $(hint config)" \
            "Change one: $(hint "config set --mem 32G")   Remove one: $(hint "config unset mem")" ;;
    esac
    mkdir -p "$ROOT"
    [[ -f $CONFIG ]] || create_default_config
    load_config
    case $sub in
        set)
            PARSING_CONFIG=yes
            parse_session_flags "$@"
            [[ $NAME_GIVEN == no ]] || die "config sets the defaults of every session; it takes no --name."
            [[ $FLAG_NOW$FLAG_ALL$FLAG_FOLLOW$RESET_DOCKER_STATE == nononono && -z $FLAG_JOB ]] ||
                die "config set takes only session options." "$OPTIONS_LINE"
            ((${#FLAG_SETTINGS[@]})) || die "config set needs an option, e.g. $(hint "config set --mem 32G")" "$OPTIONS_LINE"
            apply_settings "command line" "${FLAG_SETTINGS[@]}"
            for kv in "${FLAG_SETTINGS[@]}"; do FILE_SET[${kv%%=*}]=${CFG[${kv%%=*}]}; done
            ;;
        unset)
            (($#)) || die "config unset needs the options to remove, e.g. $(hint "config unset mem gres")" "$OPTIONS_LINE"
            for word in "$@"; do
                k=$(option_key "--${word#--}") || k=$(option_key "$word") ||
                    die "config unset: '$word' is not a session option." "$OPTIONS_LINE"
                if [[ -v FILE_SET[$k] ]]; then unset "FILE_SET[$k]"; else say "--$k was not set; nothing to remove."; fi
            done
            ;;
    esac
    if [[ -n $sub ]]; then
        write_config
        load_config
        say "saved to $CONFIG"
    fi
    sbatch_options $'\n'
    printf '\n'
}

# ---------------------------------------------------------------- command: install (run by setup)

cmd_install() {
    local src installed_serial
    src="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    installed_serial=$(sed -n 's/^ASD_DEV_SERIAL=\([0-9]*\)$/\1/p' "$ROOT/bin/asd-dev" 2>/dev/null | head -n1 || true)
    if ((${installed_serial:-0} > ASD_DEV_SERIAL)) && [[ ${ASD_DEV_ALLOW_DOWNGRADE:-} != yes ]]; then
        printf 'ASD_DEV_NEWER_INSTALLED %s %s\n' "$(sed -n 's/^ASD_DEV_VERSION=//p' "$ROOT/bin/asd-dev" | head -n1)" "$ASD_DEV_VERSION"
        die "your cluster home has a newer asd-dev than this copy of wato_asd_tooling ($ASD_DEV_VERSION)." \
            "Update your copy (git pull in wato_asd_tooling) and run setup again."
    fi
    umask 077
    mkdir -p "$ROOT/bin" "$SESSIONS" "$LOGS"
    chmod 700 "$ROOT"
    if [[ $src != "$ROOT/bin/asd-dev" ]]; then
        cp "$src" "$ROOT/bin/asd-dev.new"
        chmod 755 "$ROOT/bin/asd-dev.new"
        mv -f "$ROOT/bin/asd-dev.new" "$ROOT/bin/asd-dev"
        [[ $src == "$ROOT/tmp/"* ]] && rm -f "$src"
    fi
    printf '%s\n' "Files of wato_asd_tooling (asd-dev): VS Code dev sessions in SLURM jobs. Run $ROOT/bin/asd-dev help" >"$ROOT/README"
    if [[ -f $CONFIG ]]; then upgrade_config; else create_default_config; fi
    load_config
    if [[ ! -f $HOSTKEY ]]; then
        ssh-keygen -q -t ed25519 -N '' -C "asd-dev session host key" -f "$HOSTKEY" </dev/null
        # Default ACLs on some homes make it group-readable, and sshd then refuses the key.
        chmod 600 "$HOSTKEY"
    fi
    find "$LOGS" -name '*.log' -mtime +14 -delete 2>/dev/null || true
    cleanup_stale
    say "session defaults: $(describe_resources)"
    say "change them with: $(hint "config set --mem 32G --gres tmpdisk:40960,shard:8192")"
    printf 'ASD_DEV_INSTALLED %s %s %s\n' "$ASD_DEV_VERSION" "$(id -un)" "$(id -u)"
    printf 'ASD_DEV_HOSTKEY %s\n' "$(cut -d' ' -f1,2 "$HOSTKEY.pub")"
    if [[ ! -s /etc/cluster/users/$(id -u)/.ssh/authorized_keys && ! -s $HOME/.ssh/authorized_keys ]]; then
        say "WARNING: found no registered SSH keys for you; connecting to sessions will fail."
    fi
}

# ---------------------------------------------------------------- the session job: docker state

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
human_size() { numfmt --to=iec --suffix=B "$(stat -L -c %s "$1")"; }

# Saving is safe only after a complete load: saving after a failed or partial load would replace
# the good saved state with an empty or partial one.
DOCKER_LOADED_MARK=/tmp/.asd-dev-docker-loaded
DOCKER_NOSAVE_MARK=/tmp/.asd-dev-docker-nosave
NOTICE_QUEUE=/tmp/.asd-dev-notices

# The default install keeps the old tooling's file names (so saved images carry over);
# other installs get their own files.
state_base() {
    local base=slurm-docker-state
    [[ $SESSION_NAME == default ]] || base+="-$SESSION_NAME"
    [[ $INSTALL_ID == .asd-dev ]] || base+="-${INSTALL_ID#.}"
    printf '%s' "$base.tar.zst"
}
docker_state_file() { printf '%s' "$DOCKER_STATE_DIR/$(state_base)"; }

# The parent directory is shared, so load and save first cd into our directory, check "." and
# then use only relative paths: they keep working on the directory that was checked.
# Returns 0 when the directory is ours alone, 1 when it is not, 2 when it does not exist.
enter_state_dir() {
    local parent owner mode
    parent=$(cd -P "$DOCKER_STATE_ROOT" 2>/dev/null && pwd) || return 2
    cd -P "$DOCKER_STATE_DIR" 2>/dev/null || return 2
    read -r owner mode < <(stat -c '%u %a' .) || return 1
    # It must be the real <parent>/<uid>, not a link to somewhere else.
    [[ $(pwd -P) == "$parent/$(id -u)" && $owner == "$(id -u)" && $mode =~ [0-7][0145][0145]$ ]]
}

STATE_NOT_OURS="is not yours alone (someone else owns it, others can write to it, or it is a link)"
state_check_hint() {
    printf 'Check it with: ls -la %s. If the folder is yours, run chmod 700 on it; if someone else created it or the file in it, ask WATcloud to remove that.' "$DOCKER_STATE_DIR"
}

# Queues a notice for the session's terminals (written once one exists, see the main loop).
queue_notice() { printf '%s\n' "$1" >>"$NOTICE_QUEUE"; }

saving_off() { # saving_off REASON WHAT_TO_DO
    : >"$DOCKER_NOSAVE_MARK"
    log "[docker] WARNING: $1. Docker started empty; saving is off for this session, so $(docker_state_file) is kept."
    queue_notice "asd-dev: $1. Docker started EMPTY, and saving docker state is OFF for this session, so your saved state is kept. $2"
}

# Renames the saved state to <file>.old-<time>. Keeps this copy and the one before it; older
# copies are deleted (state files can be many GB on the shared drive). Runs in the state dir.
move_state_aside() { # move_state_aside WHY
    local base old gone
    base=$(state_base)
    old="$base.old-$(date '+%Y%m%d-%H%M%S')"
    mv -f "./$base" "./$old"
    rm -f "./$base.size" "./$base.failures"
    # shellcheck disable=SC2012 # our own file names; the timestamp makes name order age order
    gone=$(ls -1 ./"$base".old-* 2>/dev/null | sort -r | tail -n +3 || true)
    if [[ -n $gone ]]; then printf '%s\n' "$gone" | while IFS= read -r f; do rm -f "$f"; done; fi
    log "[docker] $1: moved $DOCKER_STATE_DIR/$base aside to $DOCKER_STATE_DIR/$old${gone:+; deleted older copies: $(printf '%s' "$gone" | tr '\n' ' ')}"
    queue_notice "asd-dev: $1, so the saved docker state was moved aside to $DOCKER_STATE_DIR/$old. The two newest such copies are kept (delete them when you no longer need them); older ones are deleted. Docker starts empty and saves a new state when this session ends."
}

# In a subshell, so that its cd into the state directory stays local.
load_docker_state() (
    local base rc=0 need avail failures use
    base=$(state_base)
    enter_state_dir || rc=$?
    if ((rc == 2)); then
        log "[docker] no saved docker state for this session yet ($DOCKER_STATE_DIR does not exist)"
        return 0
    elif ((rc != 0)); then
        saving_off "your docker-state folder $DOCKER_STATE_DIR $STATE_NOT_OURS, so it was not used" "$(state_check_hint)"
        return 0
    fi
    [[ -f ./$base ]] || {
        log "[docker] no saved docker state for this session yet ($DOCKER_STATE_DIR/$base)"
        return 0
    }
    exec 3<"./$base"
    if [[ $(stat -L -c %u /dev/fd/3) != "$(id -u)" ]]; then
        saving_off "your saved docker state $DOCKER_STATE_DIR/$base $STATE_NOT_OURS, so it was not used" "$(state_check_hint)"
        return 0
    fi
    if [[ $RESET_DOCKER_STATE == yes ]]; then
        move_state_aside "you asked for --reset-docker-state"
        return 0
    fi
    # Saves record their unpacked size next to the archive. The old scripts rewrite the default
    # archive without one, so a record older than the archive does not count.
    need=""
    if [[ -f ./$base.size && ! ./$base -nt ./$base.size ]]; then need=$(cat "./$base.size" 2>/dev/null || true); fi
    avail=$(df --output=avail -B1 /tmp | tail -n1 | tr -d ' ')
    if [[ $need =~ ^[0-9]+$ && $avail =~ ^[0-9]+$ ]] && ((need + need / 10 > avail)); then
        saving_off "the saved docker state needs $(numfmt --to=iec "$need")B in /tmp, but this session has only $(numfmt --to=iec "$avail")B" \
            "To restore it: $(restart_hint "--gres $(gres_with_tmpdisk $((need * 12 / 10 / 1048576 + 4096)))")"
        return 0
    fi
    log "[docker] loading saved docker state ($(human_size /dev/fd/3)) from $DOCKER_STATE_DIR/$base ..."
    if zstd -q -d --stdout <&3 | rootlesskit tar --blocking-factor=64 -xpf - -C / tmp/docker; then
        rm -f "./$base.failures"
        log "[docker] docker state loaded"
        return 0
    fi
    use=$(df -P /tmp | awk 'NR == 2 { sub(/%/, "", $5); print $5 }')
    rootlesskit rm -rf /tmp/docker || true
    if [[ $use =~ ^[0-9]+$ ]] && ((use >= 95)); then
        saving_off "restoring the saved docker state ran out of /tmp" \
            "To restore it: $(restart_hint "--gres $(gres_with_tmpdisk $(($(df --output=size -B1M /tmp | tail -n1 | tr -d ' ') * 2)))")"
        return 0
    fi
    failures=$(($(cat "./$base.failures" 2>/dev/null || echo 0) + 1))
    if ((failures >= 2)); then
        move_state_aside "the saved docker state could not be restored twice in a row (it looks damaged)"
        return 0
    fi
    (umask 077 && echo "$failures" >"./$base.failures")
    saving_off "the saved docker state could not be restored; it looks damaged" \
        "To discard it: $(restart_hint --reset-docker-state) (after one more failed restore it is moved aside by itself)."
)

start_docker() {
    if [[ $DOCKER_STATE == yes ]]; then load_docker_state; fi
    : >"$DOCKER_LOADED_MARK"
    log "[docker] starting rootless dockerd"
    /opt/slurm/bin/slurm-start-dockerd.sh 2>&1 | sed -u 's/^/[docker] /'
}

stop_dockerd() {
    local pid i
    pid=$(cat /tmp/run/docker.pid 2>/dev/null || true)
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null || return 0
    log "[docker] stopping dockerd (pid $pid) so its state is consistent"
    kill -TERM "$pid" 2>/dev/null || true
    for ((i = 0; i < 60; i++)); do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done
    log "[docker] WARNING: dockerd did not exit within 60 s"
}

# In a subshell, so that its cd into the state directory stays local.
save_docker_state() (
    local why=$1 base tmp="" size
    [[ $DOCKER_STATE == yes && -d /tmp/docker ]] || return 0
    if [[ ! -e $DOCKER_LOADED_MARK ]]; then
        log "[docker] not saving docker state: it was still being loaded"
        return 0
    fi
    if [[ -e $DOCKER_NOSAVE_MARK ]]; then
        log "[docker] not saving docker state: saving is off for this session (see above), the saved file is kept"
        return 0
    fi
    base=$(state_base)
    # First use: -m sets the mode as the directory is created (no window between mkdir and chmod).
    mkdir -m 700 "$DOCKER_STATE_DIR" 2>/dev/null || true
    if ! enter_state_dir; then
        log "[docker] WARNING: not saving docker state: $DOCKER_STATE_DIR $STATE_NOT_OURS"
        notify_terminals "asd-dev: docker state NOT saved: your docker-state folder $DOCKER_STATE_DIR $STATE_NOT_OURS. $(state_check_hint)"
        return 0
    fi
    log "[docker] saving docker state ($why) to $DOCKER_STATE_DIR/$base ..."
    # Leftovers of saves that SLURM killed (old ones only, in case another job is saving now).
    find . -maxdepth 1 \( -name "$base.tmp.*" -o -name "$base.size.*" \) -mmin +60 -delete 2>/dev/null || true
    # A save cut short by SLURM leaves a partial archive; the previous save stays in place.
    trap '[[ -n $tmp ]] && rm -f "./$tmp"; exit 143' TERM INT HUP
    tmp=$(mktemp "$base.tmp.XXXXXX")
    # Read the archive back before it replaces the previous one; that also yields the unpacked
    # size, which the next load compares with the free /tmp space.
    if rootlesskit tar -C / -cf - tmp/docker | zstd -q -T0 -3 >"./$tmp" &&
        size=$(zstd -q -d --stdout "./$tmp" | wc -c) && ((size > 0)) && mv -f "./$tmp" "./$base"; then
        tmp=""
        (umask 077 && printf '%s\n' "$size" >"./$base.size.$$") && mv -f "./$base.size.$$" "./$base.size" || true
        rm -f "./$base.failures"
        log "[docker] docker state saved ($(human_size "./$base"), $(numfmt --to=iec "$size")B unpacked)"
    else
        rm -f "./$tmp"
        tmp=""
        log "[docker] WARNING: saving docker state failed; the previous save is kept"
    fi
)

# ---------------------------------------------------------------- the session job: sshd

# Environment for ssh sessions: sshd starts them with a clean environment, without the job's.
session_setenv() {
    local vars=(SLURM_JOB_ID SLURM_JOBID SLURM_JOB_NAME SLURM_JOB_NODELIST SLURM_NODELIST SLURM_JOB_PARTITION
        SLURM_CPUS_ON_NODE SLURM_JOB_CPUS_PER_NODE SLURM_MEM_PER_NODE SLURM_JOB_END_TIME SLURM_CLUSTER_NAME
        SLURM_JOB_GPUS SLURM_GPUS_ON_NODE CUDA_VISIBLE_DEVICES GPU_DEVICE_ORDINAL)
    local out="XDG_RUNTIME_DIR=/tmp/run DOCKER_HOST=unix:///tmp/run/docker.sock TMPDIR=/tmp"
    out+=" ASD_DEV_SESSION=$SESSION_NAME"
    [[ $PATH != *[\"\\]* ]] && out+=" PATH=\"$ROOT/bin:$PATH\""
    local v
    for v in "${vars[@]}"; do
        [[ -n ${!v:-} && ${!v} != *[[:space:]\"\\]* ]] && out+=" $v=${!v}"
    done
    printf '%s' "$out"
}

port_in_use() { ss -Hltn "( sport = :$1 )" 2>/dev/null | grep -q .; }

# Starts sshd on the first free candidate port. Sets SSHD_PID and PORT.
start_sshd() {
    local candidates=("$@") p i opts=(
        -h "$HOSTKEY"
        -o PidFile=none
        -o "AuthorizedKeysFile=/etc/cluster/users/%U/.ssh/authorized_keys .ssh/authorized_keys"
        -o AuthenticationMethods=publickey
        -o PasswordAuthentication=no
        -o KbdInteractiveAuthentication=no
        -o UsePAM=no
        -o UseDNS=no
        -o PrintMotd=no
        -o PrintLastLog=no
        -o "Subsystem=sftp internal-sftp"
        -o ClientAliveInterval=30
        -o ClientAliveCountMax=4
        -o AllowTcpForwarding=yes
        -o AllowAgentForwarding=yes
        -o X11Forwarding=no
        -o "SetEnv=$(session_setenv)"
    )
    [[ -n $ADDR ]] && opts+=(-o "ListenAddress=$ADDR")
    for p in "${candidates[@]}"; do
        port_in_use "$p" && continue
        /usr/sbin/sshd -D -e -f /dev/null -p "$p" "${opts[@]}" </dev/null &
        SSHD_PID=$!
        for ((i = 0; i < 50; i++)); do
            sleep 0.1
            kill -0 "$SSHD_PID" 2>/dev/null || break
            if port_in_use "$p"; then
                PORT=$p
                return 0
            fi
        done
        kill "$SSHD_PID" 2>/dev/null || true
        wait "$SSHD_PID" 2>/dev/null || true
        log "port $p did not work; trying another"
    done
    return 1
}

write_state() {
    local tmp
    tmp=$(mktemp "$SESSIONS/.$SLURM_JOB_ID.XXXXXX")
    printf 'job=%s\nname=%s\nnode=%s\naddr=%s\nport=%s\nversion=%s\n' \
        "$SLURM_JOB_ID" "$SESSION_NAME" "$(hostname -s)" "$ADDR" "$PORT" "$ASD_DEV_VERSION" >"$tmp"
    mv -f "$tmp" "$(state_file "$SLURM_JOB_ID")"
}

# ---------------------------------------------------------------- the session job: notices, end

# Prints the terminals (pts/N) of this job's processes (from the job's cgroup): VS Code terminals
# and ssh sessions.
job_terminals() {
    local cg pids
    cg=$(sed -n 's/^0:://p' /proc/self/cgroup)
    pids=$(find "/sys/fs/cgroup${cg%%/step_*}" -name cgroup.procs -exec cat {} + 2>/dev/null | tr '\n' ',' || true)
    [[ -n $pids ]] || return 0
    ps -o tty= -p "${pids%,}" 2>/dev/null | sort -u | grep '^pts/' || true
}

notify_terminals() {
    local tty
    for tty in $(job_terminals); do
        printf '\r\n\033[1;33m%s\033[0m\n' "$1" >"/dev/$tty" 2>/dev/null || true
    done
}

# This job's --gres with tmpdisk set to $1 MiB (for hints that give the next session more /tmp).
gres_with_tmpdisk() {
    local items item out="tmpdisk:$1"
    IFS=, read -ra items <<<"$JOB_GRES"
    for item in "${items[@]}"; do
        if [[ $item != tmpdisk && $item != tmpdisk:* ]]; then out+=",$item"; fi
    done
    printf '%s' "$out"
}

# Warns once when the job's /tmp (docker's data root) is nearly full.
check_tmp_space() {
    local use msg mib
    use=$(df -P /tmp 2>/dev/null | awk 'NR == 2 { sub(/%/, "", $5); print $5 }')
    [[ $use =~ ^[0-9]+$ ]] || return 0
    if ((use >= 90)) && [[ $TMP_WARNED != yes ]]; then
        TMP_WARNED=yes
        msg="asd-dev: /tmp of this session is ${use}% full ($(df -Ph /tmp | awk 'NR == 2 { print $3 " of " $2 }'));"
        msg+=" docker keeps its images there. Free space with 'docker system prune', or give the next session more:"
        mib=$(($(df --output=size -B1M /tmp | tail -n1 | tr -d ' ') * 2))
        ((mib > 40960)) || mib=40960
        msg+=" asd-dev config set --gres $(gres_with_tmpdisk "$mib") here, then $(restart_hint)"
        log "$msg"
        notify_terminals "$msg"
    elif ((use < 80)); then
        TMP_WARNED=no
    fi
}

# .stopping stays until cleanup_stale: SLURM lists the job for a moment after this script ends.
remove_job_files() { rm -f "$(state_file "$SLURM_JOB_ID")" "$SESSIONS/$SLURM_JOB_ID.stop"; }

finish() { # finish REASON
    # First, so the proxy and "asd-dev start" report "stopping" meanwhile.
    : >"$SESSIONS/$SLURM_JOB_ID.stopping"
    log "stopping: $1"
    notify_terminals "asd-dev: this session (job $SLURM_JOB_ID) is stopping: $1."
    rm -f "$(state_file "$SLURM_JOB_ID")"
    kill "$SSHD_PID" 2>/dev/null || true
    if [[ $DOCKER_STATE == yes ]]; then
        stop_dockerd
        save_docker_state "$1"
    fi
    remove_job_files
    log "session ended"
    exit 0
}

on_term() {
    log "SLURM is ending the job (time limit or scancel)"
    notify_terminals "asd-dev: SLURM is ending this session now (time limit reached, or the job was cancelled)."
    remove_job_files
    exit 143
}

cmd_job() {
    [[ -n ${SLURM_JOB_ID:-} ]] || die "'_job' runs inside the SLURM session job; use 'asd-dev start'."
    SESSION_NAME=${1:-default}
    shift || true
    check_name "$SESSION_NAME"
    local kv
    DOCKER_STATE=yes RESET_DOCKER_STATE=no JOB_GRES="tmpdisk:$TMPDISK_DEFAULT"
    for kv in "$@"; do
        case $kv in
            docker_state=*) DOCKER_STATE=${kv#*=} ;;
            reset_docker_state=*) RESET_DOCKER_STATE=${kv#*=} ;;
            gres=*) JOB_GRES=${kv#*=} ;;
        esac
    done
    # Traps first: with a short --time, SLURM's USR1 can arrive within seconds of the start.
    WARN_REQUESTED=no SSHD_PID="" PORT="" TMP_WARNED=no
    trap on_term TERM INT HUP
    trap 'WARN_REQUESTED=yes' USR1
    unset SSH_AUTH_SOCK SSH_CLIENT SSH_CONNECTION SSH_TTY
    DOCKER_STATE_DIR="$DOCKER_STATE_ROOT/$(id -u)"
    mkdir -p "$SESSIONS" "$LOGS"
    log "asd-dev $ASD_DEV_VERSION: session '$SESSION_NAME', job $SLURM_JOB_ID on $(hostname -s)," \
        "${SLURM_CPUS_ON_NODE:-?} CPUs, ${SLURM_MEM_PER_NODE:-?} MB RAM, $(df -Ph /tmp | awk 'NR == 2 { print $2 }') /tmp," \
        "docker_state=$DOCKER_STATE"
    if [[ ! -f $HOSTKEY ]]; then
        log "ERROR: $HOSTKEY is missing; run the setup script on your laptop again"
        exit 1
    fi

    ADDR=$(getent ahostsv4 "$(hostname -s).$CLUSTER_DOMAIN" 2>/dev/null | awk 'NR == 1 { print $1 }' || true)
    if [[ -z $ADDR ]]; then
        ADDR=$(ip -4 -o addr show 2>/dev/null | awk '$4 ~ /^10\.0\.50\./ { sub(/\/.*/, "", $4); print $4; exit }' || true)
    fi
    [[ -n $ADDR ]] || log "WARNING: could not find this node's cluster network address; sshd listens on all addresses"
    local candidates=() i
    for ((i = 0; i < 10; i++)); do candidates+=($((20000 + RANDOM % 12000))); done
    if ! start_sshd "${candidates[@]}"; then
        log "ERROR: could not start sshd on any port"
        exit 1
    fi
    write_state
    log "sshd listening on ${ADDR:-*}:$PORT (pid $SSHD_PID); connect with VS Code to $(host_alias "$SESSION_NAME")"

    # Docker state is saved with dockerd stopped, so the session ends before its time limit to have
    # the time for that: 5 min early, or a third of the run time for short sessions.
    local end=${SLURM_JOB_END_TIME:-0} begin=${SLURM_JOB_START_TIME:-0} early_end=0 margin
    if [[ $DOCKER_STATE == yes && $end =~ ^[0-9]+$ && $begin =~ ^[0-9]+$ ]] && ((end - begin > 120)); then
        margin=$(((end - begin) / 3))
        ((margin > 300)) && margin=300
        early_end=$((end - margin))
    fi

    start_docker &

    local tick=0 line
    while true; do
        sleep 5 &
        wait $! || true
        [[ -e $SESSIONS/$SLURM_JOB_ID.stop ]] && finish "stopped with 'asd-dev stop'"
        if [[ $WARN_REQUESTED == yes ]]; then
            WARN_REQUESTED=no
            if ((early_end > 0)); then
                notify_terminals "asd-dev: this session (job $SLURM_JOB_ID) ends at $(date -u -d "@$early_end" '+%H:%M') UTC, shortly before its time limit, to save docker state. Save your work."
            else
                notify_terminals "asd-dev: this session (job $SLURM_JOB_ID) reaches its time limit in 10 minutes and then stops. Save your work."
            fi
        fi
        if ((early_end > 0 && $(date +%s) >= early_end)); then
            finish "it reached its time limit (ended $(((end - early_end) / 60)) min early to save docker state)"
        fi
        if ! kill -0 "$SSHD_PID" 2>/dev/null; then
            log "WARNING: sshd exited; restarting it on port $PORT"
            start_sshd "$PORT" || finish "sshd could not be restarted"
        fi
        if [[ -s $NOTICE_QUEUE && -n $(job_terminals) ]]; then
            while IFS= read -r line; do notify_terminals "$line"; done <"$NOTICE_QUEUE"
            : >"$NOTICE_QUEUE"
        fi
        tick=$((tick + 1))
        ((tick % 12 == 0)) && check_tmp_space
    done
}

# ---------------------------------------------------------------- main

usage() {
    # Commands in the form that works where this is read (./asd-dev, .\asd-dev.cmd or asd-dev).
    local p i w=0
    if [[ $FROM == laptop ]]; then p='./asd-dev '; else p=$(hint ""); fi
    local rows=(
        "start [--name NAME] [options]" "start a session and wait until VS Code can connect to it"
        "stop [--name NAME] [--now]" "stop a session (saves docker state first unless --now)"
        "stop --all | --job ID" ""
        "status [--name NAME]" "list your sessions"
        "logs [--name NAME] [-f]" "show a session's log"
        "config" "show your defaults ($CONFIG)"
        "config set [options]" "change them, e.g. config set --mem 32G"
        "config unset OPTION..." "remove them (back to the built-in default), e.g. config unset mem"
        "version" ""
    )
    for ((i = 0; i < ${#rows[@]}; i += 2)); do
        if ((${#p} + ${#rows[i]} > w)); then w=$((${#p} + ${#rows[i]})); fi
    done
    {
        cat <<EOF
asd-dev $ASD_DEV_VERSION: VS Code dev sessions inside WATcloud SLURM jobs.
On your laptop run this as ./asd-dev (or .\asd-dev.cmd) in your wato_asd_tooling folder; in a
session's terminal as asd-dev; on a login node as ~/$INSTALL_ID/bin/asd-dev.

EOF
        for ((i = 0; i < ${#rows[@]}; i += 2)); do
            if [[ -n ${rows[i + 1]} ]]; then printf '  %-*s  %s\n' "$w" "$p${rows[i]}" "${rows[i + 1]}"; else printf '  %s\n' "$p${rows[i]}"; fi
        done
        cat <<EOF

Session options, sbatch's own (one-off with start; saved as defaults with config set):
  $SESSION_OPTIONS
  e.g. --gres tmpdisk:40960 (CARLA), --gres shard:8192 (8 GiB slice of a GPU), --gres gpu:rtx_3090:1
  A --gres replaces the saved one but keeps its tmpdisk (the job's /tmp) unless it names one;
  without any, tmpdisk:$TMPDISK_DEFAULT.
start only: --reset-docker-state (move the saved docker state aside and start empty)

Connecting VS Code to asd-dev-session[-NAME] only connects; it never starts a session.
--name runs more than one session: "${p}start --name gpu" is reached as "asd-dev-session-gpu".
Without --name it is the default session (in a session's terminal: that session).
EOF
        if [[ $FROM == unix || $FROM == windows ]]; then printf 'Laptop-only commands (code, ssh, add, setup): %shelp\n' "$p"; fi
    } >&2
}

main() {
    case ${1:-} in
        --from=unix | --from=windows) FROM=${1#--from=}; shift ;;
    esac
    local cmd=${1:-help}
    shift || true
    case $cmd in
        proxy) cmd_proxy "$@" ;;
        start) cmd_start "$@" ;;
        stop) cmd_stop "$@" ;;
        status) cmd_status "$@" ;;
        logs | log) cmd_logs "$@" ;;
        config) cmd_config "$@" ;;
        install) cmd_install "$@" ;;
        _job) cmd_job "$@" ;;
        version | --version) printf '%s\n' "$ASD_DEV_VERSION" ;;
        help | -h | --help) usage ;;
        *) usage; die "unknown command '$cmd'" ;;
    esac
}

main "$@"
